# =============================================================================
# ALL NEWS JOURNAL — ENVIRONMENT VARIABLES CONFIGURATION
# =============================================================================

# --- GEMINI / LLM ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- SEARCH & RESEARCH (ON-DEMAND HOT TOPICS) ---
# Chave da Tavily Search API. Opcional: caso não configurada, o pipeline utiliza
# fallback resiliente para Google News RSS em tempo real.
TAVILY_API_KEY=tvly-your_tavily_key_here

# --- MEDIA & IMAGENS (ON-DEMAND HOT TOPICS) ---
# Chave da Unsplash API. Opcional: caso não configurada, o pipeline busca
# dinamicamente no acervo público da Wikimedia Commons (namespace 6) e fallbacks temáticos.
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# --- INSTAGRAM DISPATCHER & GRAPH API ---
# Flag mestre para habilitar publicação real no Instagram (se false, opera em DRY_RUN)
INSTAGRAM_ENABLED=false
INSTAGRAM_DELIVERY=post

# Meta Instagram Graph API (Oficial)
INSTAGRAM_ACCESS_TOKEN=your_meta_user_or_page_access_token_here
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id_here

# instagrapi (Sessão headless mobile privada)
INSTAGRAM_USER=allnewsjournal
INSTAGRAM_PASS=your_instagram_password
INSTAGRAM_SESSION=base64_encoded_session_json_string

# --- EMAIL & DISTRIBUTION ---
RESEND_API_KEY=re_your_resend_api_key
INSTAGRAM_EMAIL_TO=gustavojustusnunes@gmail.com

# --- JEV QUALITY GATE / TYPESAFE DECISION ENGINE ---
TYPESAFE_API_KEY=your_typesafe_key_here
JEV_GATE_MODE=HYBRID
