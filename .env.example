# ============================
# All News Journal - Configuração
# ============================

# Chave da API Anthropic (obrigatória)
# Pegue em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Configuração do e-mail (Gmail)
# Use uma "Senha de App" do Google, NÃO sua senha normal
# Tutorial: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# E-mail remetente (aparece no "De:")
FROM_EMAIL=seuemail@gmail.com
FROM_NAME=All News Journal
