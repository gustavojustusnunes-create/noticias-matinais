# ═══════════════════════════════════════════════════════════════
# All News Journal — Variáveis de Ambiente
# ═══════════════════════════════════════════════════════════════
# Copie este arquivo para .env e preencha com seus dados reais.
# NUNCA commite o arquivo .env no repositório!
#
# cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ── API do Claude (Anthropic) ───────────────────────────────────
# Obtenha em: https://console.anthropic.com/
CLAUDE_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Configurações de Email (SMTP) ───────────────────────────────
# Email que envia as edições (recomendado: Gmail com App Password)
EMAIL_USER=seuemail@gmail.com
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx   # App Password do Gmail (não a senha normal)
EMAIL_FROM=seuemail@gmail.com        # Pode ser igual ao EMAIL_USER
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ── Google Cloud (Google Sheets) ────────────────────────────────
# JSON completo da Service Account em uma linha (ou caminho do arquivo)
GCP_JSON={"type":"service_account","project_id":"...","private_key_id":"..."}

# ── URLs ─────────────────────────────────────────────────────────
# URL do app Streamlit para a página de cancelamento
URL_CANCELAMENTO=https://allnewsjournal.streamlit.app/?acao=cancelar
