# ===================================================================
# All News Journal — Variáveis de Ambiente (TEMPLATE)
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commit o .env (já está no .gitignore).
# ===================================================================

# Anthropic API (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Gmail SMTP (use App Password, não a senha normal)
EMAIL_USER=seuemail@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM=All News Journal <seuemail@gmail.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Google Sheets (Service Account JSON em UMA linha)
GCP_JSON={"type":"service_account",...}
GOOGLE_SHEETS_ID=

# Portal Streamlit
URL_CANCELAMENTO=https://allnewsjournal.streamlit.app/?acao=cancelar

# Instagram (deixe vazio por enquanto)
INSTAGRAM_USER=
INSTAGRAM_PASS=
INSTAGRAM_ENABLED=false
