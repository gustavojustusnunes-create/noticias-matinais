<script is:inline>
  let schemaData = null;
  let pollIntervalId = null;
  let isAutoPolling = true;
  let activeNodeId = null;

  // Zoom & Pan
  let scale = 1;
  let pointX = 0;
  let pointY = 0;
  let startX = 0;
  let startY = 0;
  let isPanning = false;

  const viewportGroup = document.getElementById("viewport-group");
  const container = document.getElementById("canvas-container");

  function updateTransform() {
    if (viewportGroup) {
      viewportGroup.setAttribute("transform", `matrix(${scale} 0 0 ${scale} ${pointX} ${pointY})`);
    }
  }

  if (container) {
    container.addEventListener("mousedown", (e) => {
      if (e.target.closest(".node-group")) return;
      isPanning = true;
      startX = e.clientX - pointX;
      startY = e.clientY - pointY;
    });

    window.addEventListener("mousemove", (e) => {
      if (!isPanning) return;
      pointX = e.clientX - startX;
      pointY = e.clientY - startY;
      updateTransform();
    });

    window.addEventListener("mouseup", () => {
      isPanning = false;
    });

    container.addEventListener("wheel", (e) => {
      e.preventDefault();
      const zoomFactor = e.deltaY < 0 ? 1.1 : 0.9;
      zoomCanvas(zoomFactor);
    }, { passive: false });
  }

  function zoomCanvas(factor) {
    const newScale = scale * factor;
    if (newScale < 0.35 || newScale > 3.5) return;
    scale = newScale;
    updateTransform();
  }

  function resetView() {
    scale = 1;
    pointX = 0;
    pointY = 0;
    updateTransform();
    setFilter("all");
  }

  // CARREGADOR REATIVO DO SCHEMA
  async function carregarSchema(isManual = false) {
    try {
      // Tenta carregar relativo ou absoluto com timestamp anti-cache
      const url = `/system_schema.json?t=${Date.now()}`;
      const res = await fetch(url);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      
      const mudou = JSON.stringify(data) !== JSON.stringify(schemaData);
      schemaData = data;

      if (mudou || isManual) {
        renderizarGrafo(data);
      }

      const lastSync = new Date(data.last_updated).toLocaleTimeString("pt-BR");
      document.getElementById("last-sync-text").innerText = `Última sincronização: ${lastSync} • Versão ${data.version}`;
      
      const activeState = data.active_run_state || {};
      activeNodeId = activeState.current_active_node || "planner";
      const statusText = activeState.status || "IDLE";
      
      const pill = document.getElementById("active-node-pill");
      pill.innerText = `Nó Ativo: ${activeNodeId} (${statusText})`;
      if (statusText === "DISPATCHED") {
        pill.className = "text-[9px] font-mono uppercase px-2 py-0.5 rounded bg-[#10B981]/20 text-[#34D399] border border-[#10B981]/40";
      } else if (statusText.includes("AWAITING")) {
        pill.className = "text-[9px] font-mono uppercase px-2 py-0.5 rounded bg-[#F59E0B]/20 text-[#FBBF24] border border-[#F59E0B]/40";
      } else {
        pill.className = "text-[9px] font-mono uppercase px-2 py-0.5 rounded bg-[#2563EB]/20 text-[#60A5FA] border border-[#2563EB]/40";
      }

    } catch (err) {
      console.warn("Aviso ao carregar schema:", err);
      const embeddedEl = document.getElementById("default-schema");
        if (embeddedEl && !schemaData) {
          try {
            const fallbackData = JSON.parse(embeddedEl.textContent);
            schemaData = fallbackData;
            renderizarGrafo(fallbackData);
            document.getElementById("last-sync-text").innerText = "Modo Offline / Local (Schema Embutido Ativo)";
            const activeState = fallbackData.active_run_state || {};
            const pill = document.getElementById("active-node-pill");
            if (pill) {
              pill.innerText = `Nó Ativo: ${activeState.current_active_node || 'planner'} (${activeState.status || 'IDLE'})`;
            }
          } catch(e) { console.error("Erro no fallback embutido:", e); }
        }
    }
  }

  // RENDERIZAÇÃO COMPLETA NO SVG
  function renderizarGrafo(data) {
    const clustersLayer = document.getElementById("clusters-layer");
    const edgesLayer = document.getElementById("edges-layer");
    const nodesLayer = document.getElementById("nodes-layer");

    // 1. Renderiza Clusters
    clustersLayer.innerHTML = (data.clusters || []).map(c => `
      <g id="cluster-${c.id}" class="cluster-group transition-opacity duration-300">
        <rect x="${c.rect.x}" y="${c.rect.y}" width="${c.rect.width}" height="${c.rect.height}" rx="16" fill="#111827" fill-opacity="0.6" stroke="${c.color}" stroke-opacity="0.3" stroke-width="1.5" stroke-dasharray="6,4" />
        <rect x="${c.rect.x}" y="${c.rect.y}" width="340" height="32" rx="8" fill="${c.color}" fill-opacity="0.15" />
        <text x="${c.rect.x + 16}" y="${c.rect.y + 21}" fill="${c.color}" font-size="11" font-weight="700" letter-spacing="1">${c.title}</text>
      </g>
    `).join("");

    // 2. Renderiza Arestas
    const nodePosMap = {};
    (data.nodes || []).forEach(n => {
      nodePosMap[n.id] = n.pos || { x: 100, y: 100 };
    });

    edgesLayer.innerHTML = (data.edges || []).map(e => {
      const src = nodePosMap[e.source];
      const tgt = nodePosMap[e.target];
      if (!src || !tgt) return "";

      const x1 = src.x + 80;
      const y1 = src.y + 45;
      const x2 = tgt.x + 80;
      const y2 = tgt.y + 45;

      let marker = "url(#arrow)";
      if (e.color === "#38BDF8") marker = "url(#arrow-blue)";
      else if (e.color === "#10B981") marker = "url(#arrow-emerald)";
      else if (e.color === "#F43F5E") marker = "url(#arrow-rose)";
      else if (e.color === "#F59E0B") marker = "url(#arrow-amber)";
      else if (e.color === "#D1BA73") marker = "url(#arrow-gold)";

      const isRetry = e.source === "critic" && e.target === "writer";
      const pathD = isRetry 
        ? `M ${src.x + 80} ${src.y} C ${src.x + 80} ${src.y - 60}, ${tgt.x + 80} ${tgt.y - 60}, ${tgt.x + 80} ${tgt.y}`
        : `M ${x1} ${y1} L ${x2} ${y2}`;

      const cssClass = isRetry ? "edge-retry" : (e.is_dashed ? "edge-flow" : "");

      return `
        <g id="${e.id}">
          <path d="${pathD}" stroke="${e.color || '#475569'}" stroke-width="${e.conditional ? 2.5 : 2}" fill="none" marker-end="${marker}" class="${cssClass}" />
          ${e.label ? `
            <text x="${(x1 + x2) / 2}" y="${(y1 + y2) / 2 - 8}" fill="${e.color}" font-size="9" font-weight="700" text-anchor="middle">${e.label}</text>
          ` : ""}
        </g>
      `;
    }).join("");

    // 3. Renderiza Nós
    const activeId = data.active_run_state?.current_active_node || "planner";
    nodesLayer.innerHTML = (data.nodes || []).map(n => {
      const pos = n.pos || { x: 100, y: 100 };
      const isActive = n.id === activeId;
      const activePulseClass = isActive ? "node-active-pulse" : "";

      return `
        <g id="node_${n.id}" class="node-group cursor-pointer group ${activePulseClass}" transform="translate(${pos.x}, ${pos.y})" onclick="selectNode('${n.id}')">
          <rect x="0" y="0" width="165" height="90" rx="12" fill="#131B26" stroke="${isActive ? '#38BDF8' : n.color}" stroke-width="${isActive ? 2.5 : 2}" class="group-hover:stroke-white transition shadow-lg" />
          <rect x="10" y="10" width="28" height="28" rx="6" fill="${n.color}" fill-opacity="0.2" />
          <text x="24" y="29" fill="${n.color}" font-size="14" text-anchor="middle">${n.icon || "⚙️"}</text>
          <text x="44" y="24" fill="#FFFFFF" font-size="12" font-weight="700">${n.label}</text>
          <text x="44" y="38" fill="${n.color}" font-size="9.5" font-weight="600">${n.sublabel || n.id}</text>
          <text x="10" y="60" fill="#94A3B8" font-size="8.5">${(n.desc || "").slice(0, 35)}...</text>
          <rect x="10" y="68" width="80" height="14" rx="4" fill="#1E293B" />
          <text x="50" y="78" fill="${n.color}" font-size="8" font-weight="700" text-anchor="middle">${n.category || "Processo"}</text>
          ${isActive ? `
            <circle cx="152" cy="12" r="4.5" fill="#38BDF8" class="animate-ping" />
            <circle cx="152" cy="12" r="3.5" fill="#38BDF8" />
          ` : ""}
        </g>
      `;
    }).join("");
  }

  // INSPECTOR DRAWER
  function selectNode(nodeId) {
    if (!schemaData || !schemaData.nodes) return;
    const node = schemaData.nodes.find(n => n.id === nodeId);
    if (!node) return;

    document.getElementById("drawer-icon").innerText = node.icon || "⚙️";
    document.getElementById("drawer-title").innerText = node.label;
    document.getElementById("drawer-file").innerText = node.file || "-";
    document.getElementById("drawer-category").innerText = node.category || "Orquestração";
    document.getElementById("drawer-func").innerText = node.func || node.id;
    document.getElementById("drawer-desc").innerText = node.desc || "-";
    document.getElementById("drawer-inputs").innerText = Array.isArray(node.inputs) ? node.inputs.join("\n") : (node.inputs || "Nenhum");
    document.getElementById("drawer-outputs").innerText = Array.isArray(node.outputs) ? node.outputs.join("\n") : (node.outputs || "Nenhum");
    document.getElementById("drawer-tech").innerHTML = `<b>Motor:</b> ${node.model || '-'}`;
    document.getElementById("drawer-resilience").innerText = node.resilience || "-";
    document.getElementById("drawer-mtime").innerText = node.file_mtime || "Recente";

    document.getElementById("node-drawer").classList.remove("translate-x-full");
  }

  function closeDrawer() {
    document.getElementById("node-drawer").classList.add("translate-x-full");
  }

  // FILTROS
  function setFilter(clusterId) {
    document.querySelectorAll(".cluster-group").forEach(c => {
      if (clusterId === "all") {
        c.style.opacity = "1";
      } else if (c.id === `cluster-${clusterId}`) {
        c.style.opacity = "1";
      } else {
        c.style.opacity = "0.2";
      }
    });
  }

  // AUTO-POLLING
  function toggleAutoPolling() {
    isAutoPolling = !isAutoPolling;
    const btn = document.getElementById("btn-toggle-poll");
    const icon = document.getElementById("poll-icon");
    const text = document.getElementById("poll-text");
    const indicator = document.getElementById("live-indicator");

    if (isAutoPolling) {
      icon.innerText = "🔄";
      text.innerText = "Auto-Sync Ativo";
      indicator.className = "text-[9px] font-bold uppercase tracking-widest px-2 py-0.5 rounded bg-[#10B981]/20 text-[#34D399] border border-[#10B981]/40 flex items-center gap-1";
      iniciarPolling();
    } else {
      icon.innerText = "⏸️";
      text.innerText = "Auto-Sync Pausado";
      indicator.className = "text-[9px] font-bold uppercase tracking-widest px-2 py-0.5 rounded bg-[#64748B]/20 text-[#94A3B8] border border-[#64748B]/40 flex items-center gap-1";
      clearInterval(pollIntervalId);
    }
  }

  function iniciarPolling() {
    clearInterval(pollIntervalId);
    pollIntervalId = setInterval(() => {
      carregarSchema(false);
    }, 5000);
  }

  // EXPORTAÇÃO
  function exportSVG() {
    const svg = document.getElementById("graph-svg");
    const serializer = new XMLSerializer();
    const source = serializer.serializeToString(svg);
    const blob = new Blob([source], { type: "image/svg+xml;charset=utf-8" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = "langgraph_topology.svg";
    a.click();
  }

  function exportPNG() {
    const svg = document.getElementById("graph-svg");
    const serializer = new XMLSerializer();
    const source = serializer.serializeToString(svg);
    const canvas = document.createElement("canvas");
    canvas.width = 1750;
    canvas.height = 1020;
    const ctx = canvas.getContext("2d");
    const img = new Image();
    const blob = new Blob([source], { type: "image/svg+xml;charset=utf-8" });
    const url = URL.createObjectURL(blob);
    img.onload = () => {
      ctx.fillStyle = "#0B0F14";
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.drawImage(img, 0, 0);
      const a = document.createElement("a");
      a.href = canvas.toDataURL("image/png");
      a.download = "langgraph_topology.png";
      a.click();
    };
    img.src = url;
  }

  // Início
  carregarSchema(true);
  iniciarPolling();
</script>
