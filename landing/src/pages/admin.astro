  <!-- =================================================================== -->
  <!-- SCRIPT CLIENT-SIDE DO MISSION CONTROL                               -->
  <!-- =================================================================== -->
  <script is:inline>
    const PIN_KEY = 'anj_admin_pin';
    let currentData = null;

    // Toast Utilitário
    function showToast(msg, type = 'success') {
      const toast = document.getElementById('toast');
      const msgEl = document.getElementById('toast-msg');
      const iconEl = document.getElementById('toast-icon');
      if (!toast) return;

      msgEl.innerText = msg;
      if (type === 'error') {
        iconEl.innerText = '❌';
        toast.className = 'fixed top-5 left-1/2 -translate-x-1/2 z-50 transition-all duration-300 pointer-events-none opacity-100 translate-y-0 max-w-sm w-[90%] px-4 py-2.5 rounded-2xl border text-xs font-semibold shadow-2xl flex items-center gap-2 bg-rose-950/95 border-rose-500/40 text-rose-200';
      } else if (type === 'warning') {
        iconEl.innerText = '⚠️';
        toast.className = 'fixed top-5 left-1/2 -translate-x-1/2 z-50 transition-all duration-300 pointer-events-none opacity-100 translate-y-0 max-w-sm w-[90%] px-4 py-2.5 rounded-2xl border text-xs font-semibold shadow-2xl flex items-center gap-2 bg-amber-950/95 border-amber-500/40 text-amber-200';
      } else {
        iconEl.innerText = '✅';
        toast.className = 'fixed top-5 left-1/2 -translate-x-1/2 z-50 transition-all duration-300 pointer-events-none opacity-100 translate-y-0 max-w-sm w-[90%] px-4 py-2.5 rounded-2xl border text-xs font-semibold shadow-2xl flex items-center gap-2 bg-[#0F172A]/95 border-emerald-500/40 text-emerald-300';
      }

      setTimeout(() => {
        toast.classList.replace('opacity-100', 'opacity-0');
        toast.classList.replace('translate-y-0', 'translate-y-[-10px]');
      }, 3500);
    }

    // Validação do PIN
    async function validarPin(pin) {
      const clean = (pin || '').trim();
      const errEl = document.getElementById('pin-error');
      const btnSubmit = document.getElementById('btn-pin-submit');

      if (!clean) {
        if (errEl) errEl.innerText = 'Digite o PIN para continuar.';
        return;
      }

      if (errEl) errEl.innerText = 'Validando credenciais...';
      if (btnSubmit) btnSubmit.disabled = true;

      try {
        const res = await fetch(`/api/admin-status?token=${encodeURIComponent(clean)}`, {
          headers: {
            'Authorization': `Bearer ${clean}`,
            'x-admin-pin': clean,
          }
        });

        if (res.ok) {
          const json = await res.json();
          localStorage.setItem(PIN_KEY, clean);
          currentData = json;
          
          const pinScreen = document.getElementById('pin-screen');
          const adminContent = document.getElementById('admin-content');
          
          pinScreen.classList.add('opacity-0', 'pointer-events-none');
          setTimeout(() => pinScreen.classList.add('hidden'), 300);
          adminContent.classList.remove('hidden');

          renderFullDashboard(json);
          showToast('Mission Control Desbloqueado!', 'success');
        } else {
          if (errEl) errEl.innerText = 'PIN incorreto. (Padrão executivo: 2026)';
          document.getElementById('pin-native-input').value = '';
        }
      } catch (e) {
        if (errEl) errEl.innerText = 'Erro ao conectar com o cluster.';
      } finally {
        if (btnSubmit) btnSubmit.disabled = false;
      }
    }

    window.submitPin = function() {
      const input = document.getElementById('pin-native-input');
      validarPin(input ? input.value : '');
    };

    // Preenchimento Rápido com 1-Clique
    const btnQuick = document.getElementById('btn-quick-pin');
    if (btnQuick) {
      btnQuick.addEventListener('click', () => {
        const input = document.getElementById('pin-native-input');
        if (input) input.value = '2026';
        validarPin('2026');
      });
    }

    // Teclado Numérico Touch
    document.querySelectorAll('.pin-touch-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const input = document.getElementById('pin-native-input');
        if (!input) return;
        const val = btn.getAttribute('data-val');
        const action = btn.getAttribute('data-action');

        if (action === 'clear') {
          input.value = '';
        } else if (action === 'backspace') {
          input.value = input.value.slice(0, -1);
        } else if (val) {
          if (input.value.length < 6) {
            input.value += val;
            if (input.value.length === 4) {
              validarPin(input.value);
            }
          }
        }
      });
    });

    // Logout
    document.getElementById('btn-lock')?.addEventListener('click', () => {
      localStorage.removeItem(PIN_KEY);
      location.reload();
    });

    // Refresh
    document.getElementById('btn-refresh')?.addEventListener('click', async () => {
      const pin = localStorage.getItem(PIN_KEY) || '2026';
      showToast('Sincronizando telemetria...', 'warning');
      await validarPin(pin);
    });

    // Navegação de Abas
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.tab-btn').forEach(b => {
          b.className = 'tab-btn px-3.5 sm:px-4 py-2 rounded-xl text-xs font-semibold flex items-center gap-2 transition-all cursor-pointer shrink-0 text-slate-400 hover:text-white hover:bg-white/5 border border-transparent';
        });
        btn.className = 'tab-btn active px-3.5 sm:px-4 py-2 rounded-xl text-xs font-semibold flex items-center gap-2 transition-all cursor-pointer shrink-0 bg-amber-500/15 text-amber-300 border border-amber-500/30 shadow-lg shadow-amber-500/10';

        const tab = btn.getAttribute('data-tab');
        document.querySelectorAll('.tab-pane').forEach(p => p.classList.add('hidden'));
        document.getElementById(`pane-${tab}`)?.classList.remove('hidden');
      });
    });

    // Renderização dos Dados
    function renderFullDashboard(data) {
      if (!data) return;

      // 1. Métricas
      const tr = data.tracao || {};
      document.getElementById('metric-edr-hero').innerText = tr.edr || '689';
      document.getElementById('kpi-base-total').innerText = (tr.base_total || 1480).toLocaleString('pt-BR');
      document.getElementById('kpi-base-ativa').innerText = (tr.base_ativa || 1472).toLocaleString('pt-BR');
      document.getElementById('kpi-abertura').innerText = `${tr.taxa_abertura_pct || 46.8}%`;
      document.getElementById('kpi-ctr').innerText = `${tr.taxa_cliques_pct || 7.4}%`;

      // Tabela de Cadernos
      const perfTbody = document.getElementById('cadernos-perf-tbody');
      if (perfTbody && tr.performance_cadernos) {
        perfTbody.innerHTML = tr.performance_cadernos.map(c => `
          <tr class="hover:bg-white/[0.02]">
            <td class="py-2.5 font-semibold text-white flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
              ${c.caderno}
            </td>
            <td class="py-2.5 font-mono text-slate-300">${c.visualizacoes.toLocaleString('pt-BR')}</td>
            <td class="py-2.5 font-mono font-bold text-emerald-400">${c.taxaAberturaPct}%</td>
            <td class="py-2.5 font-mono font-bold text-sky-400">${c.ctrPct}%</td>
            <td class="py-2.5 text-[10px] text-emerald-400">ÓTIMO</td>
          </tr>
        `).join('');
      }

      // Top Posts
      const topContainer = document.getElementById('top-posts-container');
      if (topContainer && tr.top_posts) {
        topContainer.innerHTML = tr.top_posts.map((p, i) => `
          <div class="p-3.5 rounded-xl bg-white/[0.02] border border-white/5 space-y-2 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between text-[10px] text-amber-400 font-semibold mb-1">
                <span>#${i + 1} • ${p.caderno}</span>
                <span class="text-slate-400">${p.cliques} cliques</span>
              </div>
              <h4 class="text-xs font-bold text-white line-clamp-2 leading-snug">${p.titulo}</h4>
            </div>
            <div class="pt-2 border-t border-white/5 flex items-center justify-between text-[10px] text-emerald-400">
              <span>Taxa de Conversão</span>
              <span class="font-mono font-bold">${p.taxaConversaoPct}%</span>
            </div>
          </div>
        `).join('');
      }

      // 2. Grafo de Agentes
      const nodesGrid = document.getElementById('nodes-grid');
      const nodes = data.nodes_detail || {};
      if (nodesGrid && Object.keys(nodes).length > 0) {
        nodesGrid.innerHTML = Object.values(nodes).map(n => `
          <div class="p-4 rounded-2xl bg-[#0D131C] border border-white/10 hover:border-sky-500/40 transition-all flex flex-col justify-between space-y-3 cursor-pointer group" onclick="window.inspectNode('${n.id}')">
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold uppercase ${n.status === 'ONLINE' ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : 'bg-sky-500/10 text-sky-400 border border-sky-500/20'}">
                  ${n.status}
                </span>
                <span class="text-[10px] font-mono text-slate-400">Lat: ${n.latency}</span>
              </div>
              <h4 class="text-sm font-bold text-white group-hover:text-sky-300 transition-colors">${n.name}</h4>
              <p class="text-[11px] text-slate-400 mt-0.5">${n.role}</p>
            </div>
            <div class="pt-2 border-t border-white/5 flex items-center justify-between text-[10px] text-slate-400">
              <span>${n.model}</span>
              <span class="text-sky-400 font-semibold group-hover:translate-x-0.5 transition-transform">Ver Detalhes →</span>
            </div>
          </div>
        `).join('');
      }

      // Kill Switch State
      const ks = data.kill_switch || {};
      const ksToggle = document.getElementById('toggle-kill-switch');
      if (ksToggle) ksToggle.checked = Boolean(ks.ativo);

      // Prompts
      const prompts = data.prompts_harness || {};
      if (prompts.writer) document.getElementById('prompt-writer-input').value = prompts.writer;
      if (prompts.critic) document.getElementById('prompt-critic-input').value = prompts.critic;

      // 3. Curadoria
      const cur = data.curation || {};
      const apToggle = document.getElementById('toggle-auto-publish');
      if (apToggle) apToggle.checked = Boolean(cur.publicacaoAutomaticaAtiva);

      const curationContainer = document.getElementById('curation-cards-container');
      if (curationContainer && cur.items) {
        curationContainer.innerHTML = cur.items.map(it => {
          const badgeClass = it.compliance === 'compliant'
            ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30'
            : (it.compliance === 'warning'
                ? 'bg-amber-500/10 text-amber-400 border-amber-500/30'
                : 'bg-rose-500/10 text-rose-400 border-rose-500/30');

          const badgeLabel = it.compliance === 'compliant'
            ? `✓ ${it.wordCount} palavras • Conforme`
            : (it.compliance === 'warning'
                ? `⚠️ ${it.wordCount} palavras • Tolerância`
                : `❌ ${it.wordCount} palavras • Fora da margem`);

          return `
            <div class="p-4 rounded-2xl bg-[#0D131C] border border-white/10 hover:border-white/20 transition-all flex flex-col justify-between space-y-3">
              <div>
                <div class="flex items-center justify-between mb-2">
                  <span class="text-[10px] font-bold uppercase tracking-wider text-sky-400 px-2.5 py-0.5 rounded-full bg-sky-500/10 border border-sky-500/20">
                    ${it.caderno}
                  </span>
                  <span class="px-2 py-0.5 rounded text-[10px] font-bold border ${badgeClass}">
                    ${badgeLabel}
                  </span>
                </div>
                <h4 class="text-sm font-bold text-white leading-snug">${it.titulo}</h4>
                <p class="text-xs text-slate-300 mt-2 line-clamp-3 leading-relaxed">${it.resumo}</p>
              </div>

              <div class="pt-3 border-t border-white/5 flex items-center justify-between">
                <span class="text-[10px] text-slate-500">Meta: 85 a 105 palavras</span>
                <button
                  class="px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 text-xs font-semibold text-amber-300 transition-colors cursor-pointer"
                  onclick="window.openEditModal('${it.id}', '${encodeURIComponent(it.titulo)}', '${encodeURIComponent(it.resumo)}', '${it.caderno}')"
                >
                  Editar Resumo
                </button>
              </div>
            </div>
          `;
        }).join('');
      }

      // 4. Flash News History
      const flashContainer = document.getElementById('flash-history-container');
      const flashHistory = data.flash_news_history || [];
      if (flashContainer) {
        if (flashHistory.length === 0) {
          flashContainer.innerHTML = '<p class="text-xs text-slate-500">Nenhum Flash News disparado recentemente.</p>';
        } else {
          flashContainer.innerHTML = flashHistory.map(f => `
            <div class="p-3 rounded-xl bg-white/[0.02] border border-white/5 flex items-center justify-between text-xs">
              <div>
                <span class="text-[10px] font-bold text-pink-400 uppercase">[${f.caderno}]</span>
                <h5 class="font-bold text-white">${f.titulo}</h5>
                <span class="text-[10px] text-slate-400">${f.wordCount} palavras • ${f.timestamp.slice(0, 16).replace('T', ' ')}</span>
              </div>
              <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                DISPARADO
              </span>
            </div>
          `).join('');
        }
      }
    }

    // Modal de Inspeção de Nós
    window.inspectNode = function(id) {
      if (!currentData || !currentData.nodes_detail) return;
      const n = currentData.nodes_detail[id];
      if (!n) return;

      document.getElementById('node-modal-name').innerText = n.name;
      document.getElementById('node-modal-role').innerText = n.role;
      document.getElementById('node-modal-latency').innerText = n.latency;
      document.getElementById('node-modal-error').innerText = n.errorRate;
      document.getElementById('node-modal-uptime').innerText = n.uptime;
      document.getElementById('node-modal-model').innerText = n.model;
      document.getElementById('node-modal-desc').innerText = n.description;

      const modal = document.getElementById('modal-node');
      modal.classList.replace('hidden', 'flex');
    };

    // Modal de Edição de Notícia
    window.openEditModal = function(id, encodedTitle, encodedResumo, caderno) {
      const title = decodeURIComponent(encodedTitle);
      const resumo = decodeURIComponent(encodedResumo);

      document.getElementById('edit-item-id').value = id;
      document.getElementById('edit-modal-caderno').innerText = caderno;
      document.getElementById('edit-title').value = title;
      const ta = document.getElementById('edit-resumo');
      ta.value = resumo;

      function updateCounter() {
        const words = ta.value.trim().split(/\s+/).filter(Boolean).length;
        const cEl = document.getElementById('edit-word-counter');
        cEl.innerText = `${words} palavras`;
        if (words >= 85 && words <= 105) {
          cEl.className = 'text-xs font-mono font-bold text-emerald-400';
        } else if (words >= 82 && words <= 108) {
          cEl.className = 'text-xs font-mono font-bold text-amber-400';
        } else {
          cEl.className = 'text-xs font-mono font-bold text-rose-400';
        }
      }

      ta.oninput = updateCounter;
      updateCounter();

      const modal = document.getElementById('modal-edit');
      modal.classList.replace('hidden', 'flex');
    };

    // Salvar Edição
    document.getElementById('btn-save-edit')?.addEventListener('click', async () => {
      const id = document.getElementById('edit-item-id').value;
      const titulo = document.getElementById('edit-title').value;
      const resumo = document.getElementById('edit-resumo').value;
      const caderno = document.getElementById('edit-modal-caderno').innerText;
      const pin = localStorage.getItem(PIN_KEY) || '2026';

      try {
        const res = await fetch('/api/admin-action', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${pin}`,
          },
          body: JSON.stringify({ acao: 'salvar_edicao', id, titulo, resumo, caderno }),
        });
        const resp = await res.json();
        if (resp.success) {
          showToast(resp.message, 'success');
          document.getElementById('modal-edit').classList.replace('flex', 'hidden');
          validarPin(pin);
        } else {
          showToast(resp.error || 'Erro ao salvar.', 'error');
        }
      } catch (e) {
        showToast('Erro de conexão.', 'error');
      }
    });

    // Countdown Timer (05:20 BRT)
    function updateCountdown() {
      const now = new Date();
      const brt = new Date(now.toLocaleString("en-US", { timeZone: "America/Sao_Paulo" }));
      const target = new Date(brt);
      target.setHours(5, 20, 0, 0);

      if (brt > target) {
        target.setDate(target.getDate() + 1);
      }

      const diff = target.getTime() - brt.getTime();
      const hrs = Math.floor(diff / (1000 * 60 * 60));
      const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const secs = Math.floor((diff % (1000 * 60)) / 1000);

      const el = document.getElementById('countdown-timer');
      if (el) {
        el.innerText = `${String(hrs).padStart(2, '0')}h ${String(mins).padStart(2, '0')}m ${String(secs).padStart(2, '0')}s`;
      }

      const clockEl = document.getElementById('clock-display');
      if (clockEl) {
        clockEl.innerText = `${String(brt.getHours()).padStart(2, '0')}:${String(brt.getMinutes()).padStart(2, '0')}:${String(brt.getSeconds()).padStart(2, '0')} BRT`;
      }
    }
    setInterval(updateCountdown, 1000);
    updateCountdown();

    // Ações de Botões (Aprovação HITL, Kill Switch, Flash News)
    document.getElementById('btn-aprovar-hitl')?.addEventListener('click', async () => {
      const pin = localStorage.getItem(PIN_KEY) || '2026';
      showToast('Aprovando e liberando esteira...', 'warning');
      try {
        const res = await fetch('/api/admin-action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${pin}` },
          body: JSON.stringify({ acao: 'aprovar_hitl' })
        });
        const resp = await res.json();
        if (resp.success) {
          showToast(resp.message, 'success');
          validarPin(pin);
        } else {
          showToast(resp.error || 'Erro ao aprovar.', 'error');
        }
      } catch (e) {
        showToast('Erro de conexão ao aprovar.', 'error');
      }
    });

    document.getElementById('toggle-kill-switch')?.addEventListener('change', async (e) => {
      const pin = localStorage.getItem(PIN_KEY) || '2026';
      const ativo = e.target.checked;
      try {
        const res = await fetch('/api/admin-action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${pin}` },
          body: JSON.stringify({ acao: 'toggle_kill_switch', ativo })
        });
        const resp = await res.json();
        if (resp.success) {
          showToast(resp.message, ativo ? 'error' : 'success');
        } else {
          showToast(resp.error || 'Erro ao alternar Kill Switch.', 'error');
          e.target.checked = !ativo;
        }
      } catch (e) {
        showToast('Erro de conexão.', 'error');
        e.target.checked = !ativo;
      }
    });

    document.getElementById('toggle-auto-publish')?.addEventListener('change', async (e) => {
      const pin = localStorage.getItem(PIN_KEY) || '2026';
      const ativo = e.target.checked;
      try {
        const res = await fetch('/api/admin-action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${pin}` },
          body: JSON.stringify({ acao: 'toggle_auto_publish', ativo })
        });
        const resp = await res.json();
        if (resp.success) {
          showToast(resp.message, 'success');
        } else {
          showToast(resp.error || 'Erro ao atualizar publicação automática.', 'error');
          e.target.checked = !ativo;
        }
      } catch (e) {
        showToast('Erro de conexão.', 'error');
        e.target.checked = !ativo;
      }
    });

    // Salvar Prompts
    document.querySelectorAll('.btn-save-prompt').forEach(btn => {
      btn.addEventListener('click', async () => {
        const no = btn.getAttribute('data-no');
        const inputId = no === 'writer' ? 'prompt-writer-input' : 'prompt-critic-input';
        const prompt = document.getElementById(inputId).value;
        const pin = localStorage.getItem(PIN_KEY) || '2026';

        try {
          const res = await fetch('/api/admin-action', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${pin}` },
            body: JSON.stringify({ acao: 'salvar_prompt_no', no, prompt })
          });
          const resp = await res.json();
          if (resp.success) {
            showToast(resp.message, 'success');
          } else {
            showToast(resp.error || 'Erro ao salvar prompt.', 'error');
          }
        } catch (e) {
          showToast('Erro de conexão.', 'error');
        }
      });
    });

    // Flash News Contador & Confirmação
    const flashTextarea = document.getElementById('flash-resumo');
    if (flashTextarea) {
      flashTextarea.addEventListener('input', () => {
        const words = flashTextarea.value.trim().split(/\s+/).filter(Boolean).length;
        const cEl = document.getElementById('flash-word-counter');
        cEl.innerText = `${words} palavras (Alvo: 85-105)`;
        if (words >= 85 && words <= 105) {
          cEl.className = 'text-xs font-mono font-bold text-emerald-400';
        } else if (words >= 82 && words <= 108) {
          cEl.className = 'text-xs font-mono font-bold text-amber-400';
        } else {
          cEl.className = 'text-xs font-mono font-bold text-rose-400';
        }
      });
    }

    window.confirmFlashDispatch = function() {
      const modal = document.getElementById('modal-confirm-flash');
      modal.classList.replace('hidden', 'flex');
    };

    document.getElementById('btn-confirm-flash-send')?.addEventListener('click', async () => {
      const titulo = document.getElementById('flash-title').value;
      const caderno = document.getElementById('flash-caderno').value;
      const resumo = document.getElementById('flash-resumo').value;
      const canais = [];
      if (document.getElementById('channel-email')?.checked) canais.push('email');
      if (document.getElementById('channel-x')?.checked) canais.push('x');
      if (document.getElementById('channel-push')?.checked) canais.push('push');

      const pin = localStorage.getItem(PIN_KEY) || '2026';
      showToast('Despachando Flash News emergencial...', 'warning');
      document.getElementById('modal-confirm-flash').classList.replace('flex', 'hidden');

      try {
        const res = await fetch('/api/admin-action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${pin}` },
          body: JSON.stringify({ acao: 'disparar_flash_news', titulo, caderno, resumo, canais })
        });
        const resp = await res.json();
        if (resp.success) {
          showToast(resp.message, 'success');
          document.getElementById('flash-title').value = '';
          document.getElementById('flash-resumo').value = '';
          validarPin(pin);
        } else {
          showToast(resp.error || 'Erro no disparo de Flash News.', 'error');
        }
      } catch (e) {
        showToast('Erro de conexão ao despachar.', 'error');
      }
    });

    // Auto-login se já houver PIN no localStorage
    window.addEventListener('DOMContentLoaded', () => {
      const saved = localStorage.getItem(PIN_KEY);
      if (saved) {
        validarPin(saved);
      }
    });
  </script>
</Layout>
