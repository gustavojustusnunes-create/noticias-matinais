    function bindGraphInteractions() {
      if (graphInteractionsBound) return;
      graphInteractionsBound = true;

      const viewport = document.getElementById('agent-graph-viewport');
      if (!viewport) return;

      let dragMode = null; // 'node' | 'pan' | null
      let draggedNodeId = null;
      let startClient = { x: 0, y: 0 };
      let startOrigin = { x: 0, y: 0 };
      let movedDistance = 0;

      viewport.addEventListener('pointerdown', (e) => {
        const nodeCard = e.target.closest('.graph-draggable-node');
        startClient = { x: e.clientX, y: e.clientY };
        movedDistance = 0;

        if (nodeCard) {
          dragMode = 'node';
          draggedNodeId = nodeCard.getAttribute('data-node-id');
          const pos = graphNodePositions[draggedNodeId] || { x: 0, y: 0 };
          startOrigin = { x: pos.x, y: pos.y };
          nodeCard.style.zIndex = '30';
        } else {
          dragMode = 'pan';
          startOrigin = { x: graphPan.x, y: graphPan.y };
        }
        viewport.setPointerCapture(e.pointerId);
      });

      viewport.addEventListener('pointermove', (e) => {
        if (!dragMode) return;
        const dx = e.clientX - startClient.x;
        const dy = e.clientY - startClient.y;
        movedDistance = Math.hypot(dx, dy);

        if (dragMode === 'node' && draggedNodeId) {
          const newX = Math.max(10, Math.min(1120, Math.round(startOrigin.x + dx / graphZoom)));
          const newY = Math.max(36, Math.min(430, Math.round(startOrigin.y + dy / graphZoom)));
          graphNodePositions[draggedNodeId] = { x: newX, y: newY };
          const cardEl = document.getElementById(`graph-node-card-${draggedNodeId}`);
          if (cardEl) {
            cardEl.style.left = `${newX}px`;
            cardEl.style.top = `${newY}px`;
          }
          renderGraphEdges();
        } else if (dragMode === 'pan') {
          graphPan.x = startOrigin.x + dx;
          graphPan.y = startOrigin.y + dy;
          updateGraphTransform();
        }
      });

      const finishPointer = (e) => {
        if (!dragMode) return;
        if (dragMode === 'node' && draggedNodeId) {
          const cardEl = document.getElementById(`graph-node-card-${draggedNodeId}`);
          if (cardEl) cardEl.style.zIndex = '';
          if (movedDistance < 6) {
            window.inspectNode(draggedNodeId);
          }
        }
        dragMode = null;
        draggedNodeId = null;
      };

      viewport.addEventListener('pointerup', finishPointer);
      viewport.addEventListener('pointercancel', finishPointer);

      // Zoom suave via roda do mouse (Scroll)
      viewport.addEventListener('wheel', (e) => {
        e.preventDefault();
        const rect = viewport.getBoundingClientRect();
        const mouseX = e.clientX - rect.left;
        const mouseY = e.clientY - rect.top;

        const prevZoom = graphZoom;
        const factor = e.deltaY < 0 ? 1.09 : 0.91;
        graphZoom = Math.max(0.45, Math.min(1.6, Number((graphZoom * factor).toFixed(3))));

        graphPan.x = mouseX - ((mouseX - graphPan.x) / prevZoom) * graphZoom;
        graphPan.y = mouseY - ((mouseY - graphPan.y) / prevZoom) * graphZoom;
        updateGraphTransform();
      }, { passive: false });

      // Botões de Filtro Rápido no Topo
      document.querySelectorAll('.graph-filter-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const filter = btn.getAttribute('data-graph-filter') || 'all';
          activeGraphFilter = filter;

          document.querySelectorAll('.graph-filter-btn').forEach(b => {
            b.className = 'graph-filter-btn px-3 py-1.5 rounded-lg text-[11px] font-mono font-semibold transition-all cursor-pointer text-slate-400 hover:text-white hover:bg-white/5 border border-transparent';
          });
          btn.className = 'graph-filter-btn px-3 py-1.5 rounded-lg text-[11px] font-mono font-bold transition-all cursor-pointer bg-[#D1BA73]/20 text-[#D1BA73] border border-[#D1BA73]/40 shadow-sm';

          renderInteractiveGraph();
          fitGraphView(filter, false);
        });
      });

      // Controles de Zoom + / - / Fit View
      document.getElementById('btn-graph-zoom-in')?.addEventListener('click', () => {
        graphZoom = Math.min(1.6, Number((graphZoom + 0.12).toFixed(2)));
        updateGraphTransform();
      });
      document.getElementById('btn-graph-zoom-out')?.addEventListener('click', () => {
        graphZoom = Math.max(0.45, Number((graphZoom - 0.12).toFixed(2)));
        updateGraphTransform();
      });
      document.getElementById('btn-graph-fit')?.addEventListener('click', () => {
        activeGraphFilter = 'all';
        document.querySelectorAll('.graph-filter-btn').forEach(b => {
          const isAll = b.getAttribute('data-graph-filter') === 'all';
          b.className = isAll
            ? 'graph-filter-btn px-3 py-1.5 rounded-lg text-[11px] font-mono font-bold transition-all cursor-pointer bg-[#D1BA73]/20 text-[#D1BA73] border border-[#D1BA73]/40 shadow-sm'
            : 'graph-filter-btn px-3 py-1.5 rounded-lg text-[11px] font-mono font-semibold transition-all cursor-pointer text-slate-400 hover:text-white hover:bg-white/5 border border-transparent';
        });
        fitGraphView('all', true);
        showToast('Layout e câmera do grafo reenquadrados!', 'success');
      });
    }

    // Navegação de Abas
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.tab-btn').forEach(b => {
          b.className = 'tab-btn px-3.5 sm:px-4 py-2 rounded-xl text-xs font-semibold flex items-center gap-2 transition-all cursor-pointer shrink-0 text-slate-400 hover:text-white hover:bg-white/5 border border-transparent';
        });
        btn.className = 'tab-btn active px-3.5 sm:px-4 py-2 rounded-xl text-xs font-semibold flex items-center gap-2 transition-all cursor-pointer shrink-0 bg-amber-500/15 text-amber-300 border border-amber-500/30 shadow-lg shadow-amber-500/10';

        const tab = btn.getAttribute('data-tab');
        document.querySelectorAll('.tab-pane').forEach(p => p.classList.add('hidden'));
        document.getElementById(`pane-${tab}`)?.classList.remove('hidden');

        if (tab === 'graph') {
          bindGraphInteractions();
          renderInteractiveGraph();
          setTimeout(() => fitGraphView(activeGraphFilter, false), 40);
        }
      });
    });

