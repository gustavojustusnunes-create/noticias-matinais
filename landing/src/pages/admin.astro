  <!-- =================================================================== -->
  <!-- SCRIPT CLIENT-SIDE DO MISSION CONTROL                               -->
  <!-- =================================================================== -->
  <script is:inline>
    const PIN_KEY = 'anj_admin_pin';
    let currentData = null;

    // Toast Utilitário
    function showToast(msg, type = 'success') {
      const toast = document.getElementById('toast');
      const msgEl = document.getElementById('toast-msg');
      const iconEl = document.getElementById('toast-icon');
      if (!toast) return;

      msgEl.innerText = msg;
      if (type === 'error') {
        iconEl.innerText = '❌';
        toast.className = 'fixed top-5 left-1/2 -translate-x-1/2 z-50 transition-all duration-300 pointer-events-none opacity-100 translate-y-0 max-w-sm w-[90%] px-4 py-2.5 rounded-2xl border text-xs font-semibold shadow-2xl flex items-center gap-2 bg-rose-950/95 border-rose-500/40 text-rose-200';
      } else if (type === 'warning') {
        iconEl.innerText = '⚠️';
        toast.className = 'fixed top-5 left-1/2 -translate-x-1/2 z-50 transition-all duration-300 pointer-events-none opacity-100 translate-y-0 max-w-sm w-[90%] px-4 py-2.5 rounded-2xl border text-xs font-semibold shadow-2xl flex items-center gap-2 bg-amber-950/95 border-amber-500/40 text-amber-200';
      } else {
        iconEl.innerText = '✅';
        toast.className = 'fixed top-5 left-1/2 -translate-x-1/2 z-50 transition-all duration-300 pointer-events-none opacity-100 translate-y-0 max-w-sm w-[90%] px-4 py-2.5 rounded-2xl border text-xs font-semibold shadow-2xl flex items-center gap-2 bg-[#0F172A]/95 border-emerald-500/40 text-emerald-300';
      }

      setTimeout(() => {
        toast.classList.replace('opacity-100', 'opacity-0');
        toast.classList.replace('translate-y-0', 'translate-y-[-10px]');
      }, 3500);
    }

    // Validação do PIN
    async function validarPin(pin) {
      const clean = (pin || '').trim();
      const errEl = document.getElementById('pin-error');
      const btnSubmit = document.getElementById('btn-pin-submit');

      if (!clean) {
        if (errEl) errEl.innerText = 'Digite o PIN para continuar.';
        return;
      }

      if (errEl) errEl.innerText = 'Validando credenciais...';
      if (btnSubmit) btnSubmit.disabled = true;

      try {
        const res = await fetch(`/api/admin-status?token=${encodeURIComponent(clean)}`, {
          headers: {
            'Authorization': `Bearer ${clean}`,
            'x-admin-pin': clean,
          }
        });

        if (res.ok) {
          const json = await res.json();
          localStorage.setItem(PIN_KEY, clean);
          currentData = json;
          
          const pinScreen = document.getElementById('pin-screen');
          const adminContent = document.getElementById('admin-content');
          
          pinScreen.classList.add('opacity-0', 'pointer-events-none');
          setTimeout(() => pinScreen.classList.add('hidden'), 300);
          adminContent.classList.remove('hidden');

          renderFullDashboard(json);
          showToast('Mission Control Desbloqueado!', 'success');
        } else {
          if (errEl) errEl.innerText = 'PIN incorreto. (Padrão executivo: 2026)';
          document.getElementById('pin-native-input').value = '';
        }
      } catch (e) {
        if (errEl) errEl.innerText = 'Erro ao conectar com o cluster.';
      } finally {
        if (btnSubmit) btnSubmit.disabled = false;
      }
    }

    window.submitPin = function() {
      const input = document.getElementById('pin-native-input');
      validarPin(input ? input.value : '');
    };

    // Preenchimento Rápido com 1-Clique
    const btnQuick = document.getElementById('btn-quick-pin');
    if (btnQuick) {
      btnQuick.addEventListener('click', () => {
        const input = document.getElementById('pin-native-input');
        if (input) input.value = '2026';
        validarPin('2026');
      });
    }

    // Teclado Numérico Touch
    document.querySelectorAll('.pin-touch-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const input = document.getElementById('pin-native-input');
        if (!input) return;
        const val = btn.getAttribute('data-val');
        const action = btn.getAttribute('data-action');

        if (action === 'clear') {
          input.value = '';
        } else if (action === 'backspace') {
          input.value = input.value.slice(0, -1);
        } else if (val) {
          if (input.value.length < 6) {
            input.value += val;
            if (input.value.length === 4) {
              validarPin(input.value);
            }
          }
        }
      });
    });

    // Logout
    document.getElementById('btn-lock')?.addEventListener('click', () => {
      localStorage.removeItem(PIN_KEY);
      location.reload();
    });

    // Refresh
    document.getElementById('btn-refresh')?.addEventListener('click', async () => {
      const pin = localStorage.getItem(PIN_KEY) || '2026';
      showToast('Sincronizando telemetria...', 'warning');
      await validarPin(pin);
    });

    // =========================================================================
    // MOTOR DO GRAFO DIRECIONADO 100% INTERATIVO (DRAG & DROP, PAN, ZOOM)
    // =========================================================================
    const GRAPH_NODE_W = 252;
    const GRAPH_NODE_H = 172;

    const DEFAULT_GRAPH_POSITIONS = {
      ingestion:     { x: 46,   y: 84 },
      orchestration: { x: 46,   y: 344 },
      cognitive:     { x: 386,  y: 84 },
      governance:    { x: 386,  y: 344 },
      multimodal:    { x: 726,  y: 84 },
      hitl_gate:     { x: 726,  y: 344 },
      delivery:      { x: 1066, y: 196 },
    };

    const GRAPH_CLUSTERS = [
      { id: 'ingestion',    title: '1. INGESTÃO & COORDENAÇÃO',                 x: 22,   y: 28, w: 300, h: 528, color: '#38BDF8' },
      { id: 'langgraph',    title: '2. NÚCLEO COGNITIVO & GOVERNANÇA (CORE)',   x: 356,  y: 28, w: 322, h: 528, color: '#D1BA73' },
      { id: 'multimodal',   title: '3. CAMADA MULTIMODAL & HITL',               x: 702,  y: 28, w: 300, h: 528, color: '#10B981' },
      { id: 'distribution', title: '4. DISTRIBUIÇÃO MULTICANAL (FAN-OUT)',      x: 1036, y: 28, w: 320, h: 528, color: '#38BDF8' },
    ];

    const GRAPH_EDGES_SPEC = [
      { id: 'e1', source: 'ingestion',     target: 'orchestration', label: 'RSS & Scraping',           type: 'vertical', color: '#38BDF8', layer: 'ingestion' },
      { id: 'e2', source: 'orchestration', target: 'cognitive',     label: 'Trigger 05:20 BRT',        type: 'bezier',   color: '#38BDF8', layer: 'langgraph' },
      { id: 'e3', source: 'cognitive',     target: 'governance',    label: 'Draft 85-105w',            type: 'vertical', color: '#38BDF8', layer: 'langgraph' },
      { id: 'e4', source: 'governance',    target: 'cognitive',     label: 'Rejeitado / Retry (≤ 2)',  type: 'loop',     color: '#D1BA73', layer: 'langgraph', isLoop: true },
      { id: 'e5', source: 'governance',    target: 'multimodal',    label: 'Aprovado (Jev Gate)',      type: 'bezier',   color: '#10B981', layer: 'multimodal' },
      { id: 'e6', source: 'multimodal',    target: 'hitl_gate',     label: 'Podcast + Card 1080p',     type: 'vertical', color: '#10B981', layer: 'multimodal' },
      { id: 'e7', source: 'hitl_gate',     target: 'delivery',      label: 'Founder Gate → Fan-out',   type: 'fanout',   color: '#38BDF8', layer: 'distribution' },
    ];

    const NODE_ICONS = {
      ingestion: '📡',
      orchestration: '🛡️',
      cognitive: '🧠',
      governance: '⚖️',
      multimodal: '🎙️',
      hitl_gate: '🔒',
      delivery: '🚀',
    };

    let graphNodePositions = JSON.parse(JSON.stringify(DEFAULT_GRAPH_POSITIONS));
    let graphZoom = 0.88;
    let graphPan = { x: 18, y: 20 };
    let activeGraphFilter = 'all';
    let isKillSwitchEmergency = false;
    let selectedGraphNodeId = null;
    let graphInteractionsBound = false;

    function updateGraphTransform() {
      const stage = document.getElementById('agent-graph-stage');
      const zoomLabel = document.getElementById('graph-zoom-label');
      if (stage) {
        stage.style.transform = `translate(${graphPan.x}px, ${graphPan.y}px) scale(${graphZoom})`;
      }
      if (zoomLabel) {
        zoomLabel.innerText = `${Math.round(graphZoom * 100)}%`;
      }
    }

    function fitGraphView(filterLayer = 'all', resetPositions = false) {
      if (resetPositions) {
        graphNodePositions = JSON.parse(JSON.stringify(DEFAULT_GRAPH_POSITIONS));
      }
      const viewport = document.getElementById('agent-graph-viewport');
      if (!viewport) return;
      const vw = viewport.clientWidth || 1150;
      const vh = viewport.clientHeight || 650;

      if (filterLayer === 'all') {
        const scaleX = (vw - 36) / 1380;
        const scaleY = (vh - 48) / 585;
        graphZoom = Math.max(0.48, Math.min(1.12, Math.min(scaleX, scaleY)));
        graphPan.x = Math.max(12, (vw - 1380 * graphZoom) / 2);
        graphPan.y = Math.max(12, (vh - 580 * graphZoom) / 2);
      } else {
        const cluster = GRAPH_CLUSTERS.find(c => c.id === filterLayer);
        if (cluster) {
          graphZoom = Math.min(1.15, Math.max(0.75, (vw - 120) / (cluster.w + 260)));
          const centerX = cluster.x + cluster.w / 2;
          const centerY = cluster.y + cluster.h / 2;
          graphPan.x = vw / 2 - centerX * graphZoom;
          graphPan.y = vh / 2 - centerY * graphZoom;
        }
      }
      updateGraphTransform();
      if (resetPositions) {
        renderInteractiveGraph();
      }
    }

    function isNodeHighlighted(nodeId, layer) {
      if (activeGraphFilter === 'all') return true;
      if (activeGraphFilter === layer) return true;
      if (activeGraphFilter === 'distribution' && nodeId === 'hitl_gate') return true;
      return false;
    }

    function isEdgeHighlighted(edge) {
      if (activeGraphFilter === 'all') return true;
      if (activeGraphFilter === edge.layer) return true;
      return false;
    }

    function renderGraphClusters() {
      const container = document.getElementById('agent-graph-clusters');
      if (!container) return;

      container.innerHTML = GRAPH_CLUSTERS.map(c => {
        const dimmed = activeGraphFilter !== 'all' && activeGraphFilter !== c.id;
        const borderColor = isKillSwitchEmergency ? 'rgba(239, 68, 68, 0.45)' : `${c.color}38`;
        const badgeColor = isKillSwitchEmergency ? '#FCA5A5' : c.color;
        return `
          <div
            style="left:${c.x}px; top:${c.y}px; width:${c.w}px; height:${c.h}px; border-color:${borderColor}; opacity:${dimmed ? '0.25' : '1'};"
            class="absolute rounded-3xl bg-[#0B0F14]/70 border border-dashed transition-all duration-300"
          >
            <div class="px-3.5 py-2 border-b border-white/5 flex items-center justify-between">
              <span style="color:${badgeColor}" class="text-[10px] font-mono font-bold tracking-wider uppercase">
                ${c.title}
              </span>
              <span class="w-1.5 h-1.5 rounded-full" style="background:${badgeColor}"></span>
            </div>
          </div>
        `;
      }).join('');
    }

    function computeEdgePath(edge) {
      const s = graphNodePositions[edge.source] || DEFAULT_GRAPH_POSITIONS[edge.source];
      const t = graphNodePositions[edge.target] || DEFAULT_GRAPH_POSITIONS[edge.target];
      const sH = edge.source === 'delivery' ? 204 : GRAPH_NODE_H;
      const tH = edge.target === 'delivery' ? 204 : GRAPH_NODE_H;

      if (edge.isLoop) {
        // Arco condicional de Autocura (Governança -> Camada Cognitiva) pela direita em dourado tracejado
        const startX = s.x + GRAPH_NODE_W;
        const startY = s.y + 42;
        const endX = t.x + GRAPH_NODE_W;
        const endY = t.y + tH - 36;
        const ctrlX = Math.max(startX, endX) + 64;
        const path = `M ${startX} ${startY} C ${ctrlX} ${startY - 10}, ${ctrlX} ${endY + 10}, ${endX} ${endY}`;
        const labelX = ctrlX - 6;
        const labelY = (startY + endY) / 2;
        return { path, labelX, labelY, startX, startY, endX, endY };
      }

      if (edge.type === 'vertical') {
        const offsetX = edge.source === 'cognitive' ? -18 : 0;
        const startX = s.x + GRAPH_NODE_W / 2 + offsetX;
        const startY = s.y + sH;
        const endX = t.x + GRAPH_NODE_W / 2 + offsetX;
        const endY = t.y;
        const midY = (startY + endY) / 2;
        const path = `M ${startX} ${startY} C ${startX} ${midY}, ${endX} ${midY}, ${endX} ${endY}`;
        return { path, labelX: (startX + endX) / 2, labelY: midY, startX, startY, endX, endY };
      }

      // Conexão lateral Bézier entre camadas
      const startX = s.x + GRAPH_NODE_W;
      const startY = s.y + sH / 2;
      const endX = t.x;
      const endY = t.y + tH / 2;
      const deltaX = Math.max(48, Math.abs(endX - startX) * 0.5);
      const path = `M ${startX} ${startY} C ${startX + deltaX} ${startY}, ${endX - deltaX} ${endY}, ${endX} ${endY}`;
      return { path, labelX: (startX + endX) / 2, labelY: (startY + endY) / 2 - 10, startX, startY, endX, endY };
    }

    function renderGraphEdges() {
      const svg = document.getElementById('agent-graph-edges-svg');
      if (!svg) return;

      const defs = `
        <defs>
          <marker id="arrow-cyan" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 1 L 10 5 L 0 9 z" fill="#38BDF8" />
          </marker>
          <marker id="arrow-gold" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 1 L 10 5 L 0 9 z" fill="#D1BA73" />
          </marker>
          <marker id="arrow-emerald" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 1 L 10 5 L 0 9 z" fill="#10B981" />
          </marker>
          <marker id="arrow-red" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 1 L 10 5 L 0 9 z" fill="#EF4444" />
          </marker>
        </defs>
      `;

      const edgesMarkup = GRAPH_EDGES_SPEC.map((edge, idx) => {
        const geom = computeEdgePath(edge);
        const highlighted = isEdgeHighlighted(edge);
        const opacity = highlighted ? '1' : '0.18';

        const strokeColor = isKillSwitchEmergency
          ? '#EF4444'
          : edge.color;

        const markerId = isKillSwitchEmergency
          ? 'arrow-red'
          : (edge.color === '#D1BA73' ? 'arrow-gold' : (edge.color === '#10B981' ? 'arrow-emerald' : 'arrow-cyan'));

        const dashArray = edge.isLoop ? '7 5' : (isKillSwitchEmergency ? '4 4' : 'none');
        const pathId = `graph-edge-path-${edge.id}`;

        // Partículas animadas de fluxo contínuo (congeladas quando Kill Switch está ativo)
        const particlesHtml = isKillSwitchEmergency
          ? `<circle cx="${geom.labelX}" cy="${geom.labelY}" r="3.5" fill="#EF4444" />`
          : `
            <circle r="${edge.isLoop ? '3.5' : '4'}" fill="${strokeColor}" filter="drop-shadow(0 0 6px ${strokeColor})">
              <animateMotion dur="${edge.isLoop ? '2.8s' : (edge.type === 'fanout' ? '1.8s' : '2.2s')}" repeatCount="indefinite" path="${geom.path}" />
            </circle>
            ${edge.type === 'fanout' ? `
              <circle r="3.5" fill="#D1BA73" filter="drop-shadow(0 0 6px #D1BA73)">
                <animateMotion dur="1.8s" begin="0.9s" repeatCount="indefinite" path="${geom.path}" />
              </circle>
            ` : ''}
          `;

        // Badge especial para a Aresta Condicional de Loop (Autocura) e rótulos de transição
        const pillWidth = edge.isLoop ? 154 : Math.max(96, edge.label.length * 6.2);
        const pillBg = isKillSwitchEmergency ? '#450A0A' : (edge.isLoop ? '#1C1608' : '#0B0F14');
        const pillBorder = isKillSwitchEmergency ? '#EF4444' : strokeColor;
        const pillText = isKillSwitchEmergency ? '#FCA5A5' : (edge.isLoop ? '#D1BA73' : '#E2E8F0');

        return `
          <g style="opacity:${opacity}; transition: opacity 0.25s ease;">
            <!-- Glow Base -->
            <path d="${geom.path}" fill="none" stroke="${strokeColor}" stroke-width="5" stroke-opacity="0.12" />
            <!-- Aresta Principal -->
            <path
              id="${pathId}"
              d="${geom.path}"
              fill="none"
              stroke="${strokeColor}"
              stroke-width="${edge.isLoop ? '2.4' : '2.2'}"
              stroke-dasharray="${dashArray}"
              marker-end="url(#${markerId})"
            />
            ${particlesHtml}
            <!-- Badge / Label da Aresta -->
            <g transform="translate(${geom.labelX - pillWidth / 2}, ${geom.labelY - 11})">
              <rect
                width="${pillWidth}"
                height="22"
                rx="8"
                fill="${pillBg}"
                fill-opacity="0.95"
                stroke="${pillBorder}"
                stroke-width="${edge.isLoop ? '1.4' : '1'}"
                stroke-opacity="0.7"
              />
              <text
                x="${pillWidth / 2}"
                y="14.5"
                text-anchor="middle"
                fill="${pillText}"
                font-family="monospace"
                font-size="9.5"
                font-weight="bold"
              >${edge.label}</text>
            </g>
          </g>
        `;
      }).join('');

      svg.innerHTML = defs + edgesMarkup;
    }

