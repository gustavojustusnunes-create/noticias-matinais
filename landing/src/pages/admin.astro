---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
---

<Layout title="ANJ — Mission Control Center | All News Journal" description="Cockpit Executivo & Governança Agêntica Multimodal">
  <main class="min-h-screen pb-24 lg:pb-12 text-slate-100 bg-[#070A0F] font-sans selection:bg-amber-500 selection:text-slate-950">
    
    <!-- =================================================================== -->
    <!-- 1. TELA DE AUTENTICAÇÃO POR PIN (MODAL EXECUTIVO FULLSCREEN)        -->
    <!-- =================================================================== -->
    <div id="pin-screen" class="fixed inset-0 z-50 bg-[#070A0F]/95 backdrop-blur-xl flex items-center justify-center p-4 transition-all duration-300">
      <div class="w-full max-w-sm rounded-3xl bg-[#0D131C] border border-white/10 p-6 md:p-8 shadow-2xl text-center space-y-6">
        
        <!-- Brand Icon -->
        <div class="mx-auto w-16 h-16 rounded-2xl bg-gradient-to-br from-amber-500/20 to-blue-600/20 border border-amber-500/30 flex items-center justify-center text-amber-400 font-serif font-black text-2xl shadow-lg shadow-amber-500/10">
          AN
        </div>

        <div>
          <span class="text-[10px] font-mono tracking-widest text-amber-400 uppercase font-semibold">
            All News Journal
          </span>
          <h2 class="text-xl font-bold text-white tracking-tight font-serif mt-1">
            Mission Control Center
          </h2>
          <p class="text-xs text-slate-400 mt-1">
            Autenticação restrita ao Fundador & Editor Executivo
          </p>
        </div>

        <!-- Formulário com Input Nativo -->
        <form id="pin-form" class="space-y-4" onsubmit="event.preventDefault(); window.submitPin();">
          <div class="relative">
            <input
              id="pin-native-input"
              type="password"
              inputmode="numeric"
              pattern="[0-9]*"
              maxlength="6"
              autocomplete="one-time-code"
              placeholder="Digite o PIN (2026)"
              class="w-full text-center tracking-[0.4em] font-mono text-2xl font-bold py-3 px-4 rounded-xl bg-[#141C28] border-2 border-white/15 text-white placeholder-slate-600 focus:outline-none focus:border-amber-400 focus:ring-2 focus:ring-amber-400/20 transition-all shadow-inner"
              autofocus
            />
          </div>

          <p id="pin-error" class="text-xs text-rose-400 font-medium min-h-[16px] transition-all"></p>

          <button
            id="btn-pin-submit"
            type="submit"
            class="w-full py-3 px-4 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs uppercase tracking-wider transition-all shadow-lg shadow-amber-500/20 flex items-center justify-center gap-2 cursor-pointer"
          >
            <span>Desbloquear Cockpit</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </button>
        </form>

        <!-- Teclado Touch Mobile (Opcional / Acessibilidade) -->
        <div class="pt-2 border-t border-white/5 space-y-2">
          <div class="grid grid-cols-3 gap-1.5 max-w-[220px] mx-auto">
            { [1, 2, 3, 4, 5, 6, 7, 8, 9].map((num) => (
              <button type="button" class="pin-touch-btn h-10 rounded-lg bg-[#141C28] hover:bg-white/10 active:scale-95 text-sm font-semibold text-white transition-all" data-val={num}>
                {num}
              </button>
            )) }
            <button type="button" class="pin-touch-btn h-10 rounded-lg bg-transparent hover:bg-white/5 text-[10px] text-slate-400 font-semibold" data-action="clear">Limpar</button>
            <button type="button" class="pin-touch-btn h-10 rounded-lg bg-[#141C28] hover:bg-white/10 active:scale-95 text-sm font-semibold text-white transition-all" data-val="0">0</button>
            <button type="button" class="pin-touch-btn h-10 rounded-lg bg-transparent hover:bg-white/5 text-slate-400 flex items-center justify-center" data-action="backspace">⌫</button>
          </div>

          <!-- Botão de Preenchimento Rápido 1-Clique -->
          <button
            type="button"
            id="btn-quick-pin"
            class="w-full text-xs text-amber-300 hover:text-amber-200 font-medium py-2 px-3 rounded-lg bg-amber-500/10 hover:bg-amber-500/20 border border-amber-500/20 transition-all flex items-center justify-center gap-1.5 cursor-pointer mt-2"
          >
            <span>⚡</span>
            <span>Preenchimento Rápido (PIN 2026)</span>
          </button>
        </div>

      </div>
    </div>

    <!-- =================================================================== -->
    <!-- 2. COCKPIT PRINCIPAL (HABILITADO APÓS AUTH)                         -->
    <!-- =================================================================== -->
    <div id="admin-content" class="hidden">
      
      <!-- TOAST DE NOTIFICAÇÃO FIXO -->
      <div id="toast" class="fixed top-5 left-1/2 -translate-x-1/2 z-50 transition-all duration-300 pointer-events-none opacity-0 translate-y-[-10px] max-w-sm w-[90%] px-4 py-2.5 rounded-2xl border text-xs font-semibold shadow-2xl flex items-center gap-2">
        <span id="toast-icon">✓</span>
        <span id="toast-msg">Notificação</span>
      </div>

      <!-- HEADER FIXO SUPERIOR -->
      <header class="sticky top-0 z-40 bg-[#070A0F]/90 backdrop-blur-xl border-b border-white/10 px-4 sm:px-8 py-3.5">
        <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
          
          <!-- Logo & Status -->
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400 font-serif font-bold text-base shadow-lg shadow-amber-500/10">
              AN
            </div>
            <div>
              <div class="flex items-center gap-2">
                <h1 class="text-sm sm:text-base font-bold text-white tracking-tight font-serif">
                  ALL NEWS JOURNAL
                </h1>
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-mono font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                  MISSION CONTROL
                </span>
              </div>
              <p class="text-[10px] text-slate-400 hidden sm:block">
                Cockpit Executivo & Governança Agêntica Multimodal
              </p>
            </div>
          </div>

          <!-- Controles Rápidos -->
          <div class="flex items-center gap-2">
            <span id="clock-display" class="hidden md:inline-block font-mono text-[11px] text-slate-400 px-2 py-1 rounded bg-white/5 border border-white/5">
              --:-- BRT
            </span>
            <button
              id="btn-refresh"
              title="Recarregar Telemetria"
              class="p-2 rounded-xl bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white border border-white/5 transition-all cursor-pointer"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
            </button>
            <button
              id="btn-lock"
              title="Bloquear Painel"
              class="p-2 rounded-xl bg-white/5 hover:bg-rose-500/20 text-slate-300 hover:text-rose-300 border border-white/5 hover:border-rose-500/30 transition-all cursor-pointer"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            </button>
          </div>

        </div>

        <!-- Barra de Navegação Desktop (4 Abas Claras) -->
        <div class="max-w-7xl mx-auto mt-3 border-t border-white/5 pt-2">
          <nav class="flex space-x-1 sm:space-x-2 overflow-x-auto scrollbar-none py-1">
            <button class="tab-btn active px-3.5 sm:px-4 py-2 rounded-xl text-xs font-semibold flex items-center gap-2 transition-all cursor-pointer shrink-0 bg-amber-500/15 text-amber-300 border border-amber-500/30 shadow-lg shadow-amber-500/10" data-tab="metrics">
              <span>📊</span>
              <span>Visão Geral & Métricas</span>
            </button>
            <button class="tab-btn px-3.5 sm:px-4 py-2 rounded-xl text-xs font-semibold flex items-center gap-2 transition-all cursor-pointer shrink-0 text-slate-400 hover:text-white hover:bg-white/5 border border-transparent" data-tab="graph">
              <span>🕸️</span>
              <span>Grafo de Agentes</span>
            </button>
            <button class="tab-btn px-3.5 sm:px-4 py-2 rounded-xl text-xs font-semibold flex items-center gap-2 transition-all cursor-pointer shrink-0 text-slate-400 hover:text-white hover:bg-white/5 border border-transparent" data-tab="curation">
              <span>✍️</span>
              <span>Curadoria de Conteúdo</span>
            </button>
            <button class="tab-btn px-3.5 sm:px-4 py-2 rounded-xl text-xs font-semibold flex items-center gap-2 transition-all cursor-pointer shrink-0 text-slate-400 hover:text-white hover:bg-white/5 border border-transparent" data-tab="flash">
              <span>⚡</span>
              <span>Flash News (Disparo)</span>
            </button>
          </nav>
        </div>
      </header>

      <!-- CONTEÚDO DAS 4 ABAS -->
      <div class="max-w-7xl mx-auto px-4 sm:px-8 pt-6">
        
        <!-- ================================================================= -->
        <!-- ABA 1: 📊 VISÃO GERAL & MÉTRICAS                                  -->
        <!-- ================================================================= -->
        <section id="pane-metrics" class="tab-pane space-y-6">
          
          <!-- North Star Metric (EDR) -->
          <div class="rounded-3xl bg-gradient-to-br from-[#0E1522] via-[#131B26] to-[#0A0E17] border border-amber-500/30 p-6 md:p-8 shadow-2xl relative overflow-hidden">
            <div class="absolute -right-8 -bottom-8 w-48 h-48 bg-amber-500/10 blur-[90px] rounded-full pointer-events-none"></div>
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
              <div>
                <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full text-[10px] font-mono font-bold bg-amber-500/10 text-amber-300 border border-amber-500/20 uppercase tracking-widest mb-2">
                  <span>★</span> NORTH STAR METRIC DO ALL NEWS JOURNAL
                </div>
                <div class="flex items-baseline gap-3">
                  <h2 id="metric-edr-hero" class="text-4xl sm:text-5xl font-extrabold text-white font-serif">689</h2>
                  <span class="text-sm sm:text-base font-semibold text-amber-400">Engaged Daily Readers (EDR)</span>
                </div>
                <p class="text-xs text-slate-400 mt-2 max-w-xl leading-relaxed">
                  Calculado matematicamente como <code class="text-amber-300">Base Ativa × Taxa de Abertura Única</code>. Representa os leitores fiéis que consom a edição analítica completa diariamente.
                </p>
              </div>
              <div class="shrink-0 flex items-center gap-3">
                <div class="p-4 rounded-2xl bg-black/40 border border-white/5 text-center">
                  <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider block">Benchmark de Mercado</span>
                  <span class="text-xl font-bold text-slate-300">42.0%</span>
                  <span class="text-[10px] text-emerald-400 font-semibold block mt-0.5">ANJ: +4.8% acima</span>
                </div>
              </div>
            </div>
          </div>

          <!-- KPI Cards Grid (6 Métricas Fundamentais) -->
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-4">
            <div class="rounded-2xl bg-[#0D131C] border border-white/10 p-4 space-y-1">
              <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Base Total</span>
              <div id="kpi-base-total" class="text-2xl font-bold text-white font-mono">1.480</div>
              <p class="text-[10px] text-emerald-400 font-medium">+84 nos 7d</p>
            </div>
            <div class="rounded-2xl bg-[#0D131C] border border-white/10 p-4 space-y-1">
              <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Base Ativa</span>
              <div id="kpi-base-ativa" class="text-2xl font-bold text-white font-mono">1.472</div>
              <p class="text-[10px] text-slate-400 font-medium">99.4% entregabilidade</p>
            </div>
            <div class="rounded-2xl bg-[#0D131C] border border-emerald-500/20 p-4 space-y-1 bg-emerald-950/10">
              <span class="text-[10px] font-semibold uppercase tracking-wider text-emerald-400">Taxa de Abertura</span>
              <div id="kpi-abertura" class="text-2xl font-bold text-emerald-300 font-mono">46.8%</div>
              <p class="text-[10px] text-emerald-400 font-medium">Resend Live API</p>
            </div>
            <div class="rounded-2xl bg-[#0D131C] border border-white/10 p-4 space-y-1">
              <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Cliques (CTR)</span>
              <div id="kpi-ctr" class="text-2xl font-bold text-sky-400 font-mono">7.4%</div>
              <p class="text-[10px] text-slate-400 font-medium">108 cliques/ed.</p>
            </div>
            <div class="rounded-2xl bg-[#0D131C] border border-white/10 p-4 space-y-1">
              <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Alcance Semanal</span>
              <div class="text-2xl font-bold text-purple-400 font-mono">24.8k</div>
              <p class="text-[10px] text-slate-400 font-medium">X & Instagram</p>
            </div>
            <div class="rounded-2xl bg-[#0D131C] border border-white/10 p-4 space-y-1">
              <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Conv. Vitrine</span>
              <div class="text-2xl font-bold text-amber-400 font-mono">4.56%</div>
              <p class="text-[10px] text-slate-400 font-medium">Landing Page</p>
            </div>
          </div>

          <!-- Funil de Tração Visual & Matriz dos 8 Cadernos (Grid 2 Colunas) -->
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            
            <!-- Funil de Tração (5 cols) -->
            <div class="lg:col-span-5 rounded-2xl bg-[#0D131C] border border-white/10 p-5 space-y-4">
              <div class="flex items-center justify-between pb-3 border-b border-white/5">
                <div>
                  <h3 class="text-xs font-bold uppercase tracking-wider text-white">Funil de Tração Editorial</h3>
                  <p class="text-[10px] text-slate-400">Conversão de tráfego social em leitores recorrentes</p>
                </div>
                <span class="text-xs">📈</span>
              </div>

              <div class="space-y-4">
                <div>
                  <div class="flex justify-between text-xs mb-1.5">
                    <span class="text-slate-400">1. Alcance Social (X / Instagram)</span>
                    <span class="font-bold text-white font-mono">24.850</span>
                  </div>
                  <div class="h-2 rounded-full bg-slate-800 overflow-hidden">
                    <div class="h-full bg-blue-500 rounded-full w-full"></div>
                  </div>
                </div>

                <div>
                  <div class="flex justify-between text-xs mb-1.5">
                    <span class="text-slate-400">2. Cliques em Links com UTM</span>
                    <span class="font-bold text-sky-400 font-mono">1.840 (7.4%)</span>
                  </div>
                  <div class="h-2 rounded-full bg-slate-800 overflow-hidden">
                    <div class="h-full bg-sky-500 rounded-full" style="width: 32%"></div>
                  </div>
                </div>

                <div>
                  <div class="flex justify-between text-xs mb-1.5">
                    <span class="text-slate-400">3. Novos Assinantes Confirmados</span>
                    <span class="font-bold text-emerald-400 font-mono">84 (Conv: 4.56%)</span>
                  </div>
                  <div class="h-2 rounded-full bg-slate-800 overflow-hidden">
                    <div class="h-full bg-emerald-500 rounded-full" style="width: 14%"></div>
                  </div>
                </div>

                <div>
                  <div class="flex justify-between text-xs mb-1.5">
                    <span class="text-slate-400">4. Leitores Diários Fiéis (EDR)</span>
                    <span class="font-bold text-amber-400 font-mono">689 (Retenção 46.8%)</span>
                  </div>
                  <div class="h-2 rounded-full bg-slate-800 overflow-hidden">
                    <div class="h-full bg-amber-500 rounded-full" style="width: 48%"></div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Matriz de Performance dos 8 Cadernos (7 cols) -->
            <div class="lg:col-span-7 rounded-2xl bg-[#0D131C] border border-white/10 p-5 space-y-3">
              <div class="flex items-center justify-between pb-3 border-b border-white/5">
                <div>
                  <h3 class="text-xs font-bold uppercase tracking-wider text-white">Desempenho dos 8 Cadernos</h3>
                  <p class="text-[10px] text-slate-400">Métricas de leitura e interesse por editoria</p>
                </div>
                <span class="text-[10px] font-mono text-emerald-400 px-2 py-0.5 rounded bg-emerald-500/10 border border-emerald-500/20 font-semibold">
                  AUDITADO
                </span>
              </div>

              <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                  <thead class="text-[10px] font-semibold uppercase text-slate-400 border-b border-white/5">
                    <tr>
                      <th class="pb-2">Caderno</th>
                      <th class="pb-2">Leituras</th>
                      <th class="pb-2">Abertura</th>
                      <th class="pb-2">CTR</th>
                      <th class="pb-2">Status</th>
                    </tr>
                  </thead>
                  <tbody id="cadernos-perf-tbody" class="divide-y divide-white/5 text-slate-200">
                    <!-- Preenchido dinamicamente via JS -->
                  </tbody>
                </table>
              </div>
            </div>

          </div>

          <!-- Top 5 Matérias Mais Engajadas -->
          <div class="rounded-2xl bg-[#0D131C] border border-white/10 p-5 space-y-3">
            <div class="flex items-center justify-between pb-2 border-b border-white/5">
              <h3 class="text-xs font-bold uppercase tracking-wider text-white">Top 5 Matérias com Maior Engajamento da Semana</h3>
              <span class="text-xs">🏆</span>
            </div>
            <div id="top-posts-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
              <!-- Preenchido dinamicamente via JS -->
            </div>
          </div>

        </section>

        <!-- ================================================================= -->
        <!-- ABA 2: 🕸️ GRAFO DE AGENTES (GRAFO DIRECIONADO 100% INTERATIVO)    -->
        <!-- ================================================================= -->
        <section id="pane-graph" class="tab-pane hidden space-y-5">
          
          <!-- Barra Superior: Status Global, Filtros de Camada & Controles de Câmera -->
          <div id="graph-toolbar-card" class="rounded-2xl bg-[#0B0F14] border border-white/10 p-4 shadow-2xl flex flex-col lg:flex-row lg:items-center justify-between gap-4 transition-colors duration-300">
            <div class="space-y-1">
              <div class="flex flex-wrap items-center gap-2.5">
                <span id="graph-status-dot" class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
                <h3 class="text-xs sm:text-sm font-bold uppercase tracking-wider text-white font-mono">
                  TOPOLOGIA DIRECIONAL LANGGRAPH & ECOSSISTEMA AUTÔNOMO
                </h3>
                <span id="graph-emergency-badge" class="hidden px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-red-500/20 text-red-300 border border-red-500/50 animate-pulse">
                  🚨 PIPELINE SUSPENSO - EMERGÊNCIA ATIVADA
                </span>
                <span id="graph-online-badge" class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
                  ● 7 NÓS ONLINE • FLUXO ATIVO
                </span>
              </div>
              <p class="text-[11px] text-slate-400">
                Arraste os nós (<strong class="text-slate-200">Drag & Drop</strong>), navegue pelo canvas (<strong class="text-slate-200">Pan & Zoom</strong>) e clique em qualquer agente para inspecionar código-fonte, política de retry e <code class="text-[#D1BA73]">GraphState</code>.
              </p>
            </div>

            <!-- Filtros Rápidos de Camada + Fit View -->
            <div class="flex flex-wrap items-center gap-1.5">
              <div class="inline-flex flex-wrap items-center gap-1 bg-[#080B0F] p-1 rounded-xl border border-white/10">
                <button type="button" data-graph-filter="all" class="graph-filter-btn px-3 py-1.5 rounded-lg text-[11px] font-mono font-bold transition-all cursor-pointer bg-[#D1BA73]/20 text-[#D1BA73] border border-[#D1BA73]/40 shadow-sm">
                  [ Todos ]
                </button>
                <button type="button" data-graph-filter="langgraph" class="graph-filter-btn px-3 py-1.5 rounded-lg text-[11px] font-mono font-semibold transition-all cursor-pointer text-slate-400 hover:text-white hover:bg-white/5 border border-transparent">
                  [ LangGraph Core ]
                </button>
                <button type="button" data-graph-filter="multimodal" class="graph-filter-btn px-3 py-1.5 rounded-lg text-[11px] font-mono font-semibold transition-all cursor-pointer text-slate-400 hover:text-white hover:bg-white/5 border border-transparent">
                  [ Multimodal & HITL ]
                </button>
                <button type="button" data-graph-filter="distribution" class="graph-filter-btn px-3 py-1.5 rounded-lg text-[11px] font-mono font-semibold transition-all cursor-pointer text-slate-400 hover:text-white hover:bg-white/5 border border-transparent">
                  [ Distribuição ]
                </button>
              </div>

              <div class="inline-flex items-center gap-1 bg-[#080B0F] p-1 rounded-xl border border-white/10">
                <button type="button" id="btn-graph-zoom-out" title="Diminuir Zoom" class="px-2.5 py-1.5 rounded-lg text-xs font-mono font-bold text-slate-300 hover:text-white hover:bg-white/10 transition-colors cursor-pointer">
                  −
                </button>
                <span id="graph-zoom-label" class="px-1.5 text-[10px] font-mono text-slate-400 min-w-[42px] text-center">
                  100%
                </span>
                <button type="button" id="btn-graph-zoom-in" title="Aumentar Zoom" class="px-2.5 py-1.5 rounded-lg text-xs font-mono font-bold text-slate-300 hover:text-white hover:bg-white/10 transition-colors cursor-pointer">
                  +
                </button>
                <button type="button" id="btn-graph-fit" title="Resetar Zoom e Enquadrar Grafo" class="px-3 py-1.5 rounded-lg text-[11px] font-mono font-bold bg-sky-500/15 hover:bg-sky-500/25 text-sky-300 border border-sky-500/30 transition-all cursor-pointer">
                  [ Fit View ]
                </button>
              </div>
            </div>
          </div>

          <!-- Canvas Interativo do Grafo Direcionado -->
          <div
            id="agent-graph-viewport"
            class="relative w-full h-[650px] rounded-3xl bg-[#080B0F] border-2 border-white/10 overflow-hidden shadow-2xl select-none cursor-grab active:cursor-grabbing transition-all duration-300"
