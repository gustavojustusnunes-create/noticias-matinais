---
---

<div class="w-full max-w-xl mx-auto" id="assinar">
  <form id="form-inscricao" class="flex flex-col sm:flex-row gap-2.5 p-1.5 rounded-xl bg-[#131B26] border border-white/[0.1] shadow-2xl shadow-black/60 focus-within:border-[#2563EB]/80 focus-within:ring-2 focus-within:ring-[#2563EB]/20 transition-all">
    <div class="relative flex-grow flex items-center">
      <div class="absolute left-3.5 text-[#94A3B8] pointer-events-none">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="20" height="16" x="2" y="4" rx="2"></rect>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        </svg>
      </div>
      <input
        type="email"
        id="email-input"
        name="email"
        required
        placeholder="Seu melhor e-mail profissional..."
        class="w-full pl-10 pr-4 py-3 bg-transparent text-white placeholder-[#64748B] text-sm focus:outline-none"
      />
    </div>

    <button
      type="submit"
      id="submit-btn"
      class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-[#2563EB] hover:bg-[#1D4ED8] text-white text-sm font-semibold whitespace-nowrap shadow-lg shadow-[#2563EB]/30 transition-all transform hover:-translate-y-0.5 active:translate-y-0 disabled:opacity-50 disabled:cursor-not-allowed"
    >
      <span id="btn-text">Quero Receber às 06:15</span>
      <svg id="btn-icon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14"></path>
        <path d="m12 5 7 7-7 7"></path>
      </svg>
      <span id="btn-spinner" class="hidden w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin"></span>
    </button>
  </form>

  <!-- Mensagem de Sucesso Instantâneo -->
  <div id="msg-sucesso" class="hidden mt-3.5 p-4 rounded-lg bg-[#10B981]/10 border border-[#10B981]/30 text-[#10B981] text-xs sm:text-sm flex items-start gap-3 transition-all animate-fadeIn">
    <div class="text-[#10B981] mt-0.5 font-bold text-base">✓</div>
    <div>
      <p class="font-semibold text-white">Inscrição confirmada com sucesso!</p>
      <p class="text-[#94A3B8] text-xs mt-0.5">Sua primeira edição executiva chegará amanhã pontualmente às 06:15 com o resumo e o podcast matinal.</p>
    </div>
  </div>

  <!-- Mensagem de Erro -->
  <div id="msg-erro" class="hidden mt-3.5 p-3 rounded-lg bg-[#EF4444]/10 border border-[#EF4444]/30 text-[#EF4444] text-xs text-center transition-all">
    Ocorreu um erro ao processar seu cadastro. Por favor, tente novamente.
  </div>
</div>

<script>
  const form = document.getElementById("form-inscricao") as HTMLFormElement;
  const input = document.getElementById("email-input") as HTMLInputElement;
  const btn = document.getElementById("submit-btn") as HTMLButtonElement;
  const btnText = document.getElementById("btn-text");
  const btnIcon = document.getElementById("btn-icon");
  const btnSpinner = document.getElementById("btn-spinner");
  const msgSucesso = document.getElementById("msg-sucesso");
  const msgErro = document.getElementById("msg-erro");

  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const email = input.value.trim();
      if (!email) return;

      // Estado de loading
      btn.disabled = true;
      if (btnText) btnText.textContent = "Cadastrando...";
      if (btnIcon) btnIcon.classList.add("hidden");
      if (btnSpinner) btnSpinner.classList.remove("hidden");
      if (msgSucesso) msgSucesso.classList.add("hidden");
      if (msgErro) msgErro.classList.add("hidden");

      try {
        const resp = await fetch("/api/subscribe", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email })
        });

        if (resp.ok) {
          form.classList.add("hidden");
          if (msgSucesso) msgSucesso.classList.remove("hidden");
        } else {
          throw new Error("Falha no cadastro");
        }
      } catch (err) {
        if (msgErro) msgErro.classList.remove("hidden");
        btn.disabled = false;
        if (btnText) btnText.textContent = "Quero Receber às 06:15";
        if (btnIcon) btnIcon.classList.remove("hidden");
        if (btnSpinner) btnSpinner.classList.add("hidden");
      }
    });
  }
</script>
