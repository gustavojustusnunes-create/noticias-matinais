---
const cadernos = [
  {
    id: "ia",
    nome: "Inteligência Artificial",
    badge: "Tecnologia & Fronteira",
    corBadge: "bg-[#8B5CF6]/15 text-[#A78BFA] border-[#8B5CF6]/30",
    descricao: "Modelos de ponta, guerra de semicondutores, agentes autônomos e implicações regulatórias globais.",
    exemplo: "China acelera ecossistema de código aberto para o BRICS e pressiona hegemonia dos EUA em chips."
  },
  {
    id: "economia",
    nome: "Economia",
    badge: "Mercados & Macro",
    corBadge: "bg-[#10B981]/15 text-[#34D399] border-[#10B981]/30",
    descricao: "Decisões do Fed e Copom, treasury yields, câmbio e movimentos de capital que impactam seu patrimônio.",
    exemplo: "Rendimento dos Treasuries americanos de 10 anos atinge pico histórico e pressiona juros emergentes."
  },
  {
    id: "mundo",
    nome: "Mundo",
    badge: "Geopolítica Global",
    corBadge: "bg-[#3B82F6]/15 text-[#60A5FA] border-[#3B82F6]/30",
    descricao: "Conflitos internacionais, eleições estratégicas e o xadrez diplomático que molda o comércio exterior.",
    exemplo: "Cúpulas multilaterais redefinem rotas de energia e comércio marítimo no Hemisfério Sul."
  },
  {
    id: "finance",
    nome: "All News Finance",
    badge: "Pré-Market Executivo",
    corBadge: "bg-[#F59E0B]/15 text-[#FBBF24] border-[#F59E0B]/30",
    descricao: "Radar diário pré-abertura com fechamento de Nova York, Ásia, futuros do Ibovespa e curva de juros.",
    exemplo: "Boletim condensado entregue aos assinantes antes das 06:30 para subsidiar decisões de investimento."
  },
  {
    id: "wellness",
    nome: "Wellness",
    badge: "Saúde & Performance",
    corBadge: "bg-[#14B8A6]/15 text-[#2DD4BF] border-[#14B8A6]/30",
    descricao: "Evidências científicas em nutrição, biohacking, sono e longevidade para profissionais de alta exigência.",
    exemplo: "Estudos controlados desmistificam impactos cardiovasculares e desfazem mitos de envelhecimento precoce."
  },
  {
    id: "ciencia",
    nome: "Ciência",
    badge: "Fronteira do Conhecimento",
    corBadge: "bg-[#6366F1]/15 text-[#818CF8] border-[#6366F1]/30",
    descricao: "Física experimental, bioengenharia, exploração aeroespacial e avanços laboratoriais disruptivos.",
    exemplo: "Laboratórios síncrotron de 4ª geração aceleram o desenvolvimento de novos materiais supercondutores."
  },
  {
    id: "politica",
    nome: "Política",
    badge: "Institucional & Neutro",
    corBadge: "bg-[#EC4899]/15 text-[#F472B6] border-[#EC4899]/30",
    descricao: "Acompanhamento legislativo e judiciário em linguagem neutra, desprovida de partidarismo e sensacionalismo.",
    exemplo: "Votações de reformas tributárias e marcos regulatórios explicados em seu impacto fiscal prático."
  },
  {
    id: "cinema",
    nome: "Cinema & Cultura",
    badge: "Indústria & Streaming",
    corBadge: "bg-[#F43F5E]/15 text-[#FB7185] border-[#F43F5E]/30",
    descricao: "Bastidores da indústria audiovisual, premiações globais e grandes produções que pautam o entretenimento.",
    exemplo: "Análise mercadológica da safra premiada no Emmy e a nova disputa de rentabilidade no streaming."
  }
];
---

<section class="py-16 sm:py-24" id="cadernos">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#131B26] border border-white/[0.08] text-xs font-semibold text-[#94A3B8] uppercase tracking-wider mb-3">
        Cobertura Abrangente
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-white tracking-tight">
        8 Cadernos Editoriais Curados Diariamente
      </h2>
      <p class="text-sm sm:text-base text-[#94A3B8] mt-2">
        Cada seção é redigida no padrão rigoroso de brevidade e densidade analítica, eliminando ruídos superficiais.
      </p>
    </div>

    <!-- Grid de Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
      {cadernos.map((c) => (
        <div class="group p-5 rounded-xl bg-[#131B26] border border-white/[0.08] hover:border-[#2563EB]/50 hover:bg-[#162030] transition-all duration-200 transform hover:-translate-y-1 flex flex-col justify-between shadow-lg shadow-black/40">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class={`text-[10px] font-semibold px-2 py-0.5 rounded-full border ${c.corBadge}`}>
                {c.badge}
              </span>
            </div>
            <h3 class="font-serif text-lg font-bold text-white group-hover:text-[#93C5FD] transition-colors mb-2">
              {c.nome}
            </h3>
            <p class="text-xs text-[#94A3B8] leading-relaxed mb-4">
              {c.descricao}
            </p>
          </div>

          <div class="pt-3 border-t border-white/[0.06]">
            <p class="text-[10px] font-semibold uppercase tracking-wider text-[#64748B] mb-1">Destaque Típico</p>
            <p class="text-xs text-[#CBD5E1] italic line-clamp-2">
              "{c.exemplo}"
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
