---
const cadernos = [
  {
    id: "macroeconomia",
    nome: "Macroeconomia & Mercados",
    badge: "Política Monetária & Capital",
    corBadge: "bg-[#10B981]/15 text-[#34D399] border-[#10B981]/30",
    descricao: "Decisões do Fed, Copom e BCE, treasury yields, liquidez global, câmbio e sustentabilidade fiscal que afetam alocações estratégicas.",
    exemplo: "Rendimento dos Treasuries americanos de 10 anos sobe com recalibragem de juros e pressiona fluxos de capital em mercados emergentes."
  },
  {
    id: "geopolitica",
    nome: "Geopolítica & Assuntos Globais",
    badge: "Relações Internacionais & Comércio",
    corBadge: "bg-[#3B82F6]/15 text-[#60A5FA] border-[#3B82F6]/30",
    descricao: "Diplomacia de alto nível, cúpulas multilaterais, disputas comerciais, rotas de energia e o equilíbrio de segurança e defesa soberana.",
    exemplo: "Realinhamento estratégico de blocos econômicos redefine cadeias de suprimento globais e impacta acordos tarifários multilaterais."
  },
  {
    id: "estrategia",
    nome: "Estratégia Corporativa & M&A",
    badge: "Alocação de Capital & Governança",
    corBadge: "bg-[#F59E0B]/15 text-[#FBBF24] border-[#F59E0B]/30",
    descricao: "Grandes fusões e aquisições, reestruturações patrimoniais, governança executiva, teses de investimento e dinâmica competitiva setorial.",
    exemplo: "Consolidação transfronteiriça no setor industrial atinge US$ 12 bilhões e reconfigura o equilíbrio de poder antitruste na Europa e Ásia."
  },
  {
    id: "fronteira-ia",
    nome: "Fronteira Tecnológica & IA",
    badge: "Infraestrutura & Semicondutores",
    corBadge: "bg-[#8B5CF6]/15 text-[#A78BFA] border-[#8B5CF6]/30",
    descricao: "Modelos de fronteira, gargalos na cadeia de semicondutores, data centers de alta densidade e ecossistemas regulatórios de IA.",
    exemplo: "Aceleração de Capex em clusters computacionais de IA pressiona a matriz energética e redefine contratos de infraestrutura física."
  },
  {
    id: "ciencia",
    nome: "Ciência & Inovação",
    badge: "Deeptech & Transição Energética",
    corBadge: "bg-[#06B6D4]/15 text-[#22D3EE] border-[#06B6D4]/30",
    descricao: "Materiais avançados, biotecnologia escalável, transição energética industrial e avanços com revisão por pares que alteram mercados.",
    exemplo: "Testes controlados validam nova classe de supercondutores com potencial de reduzir perdas em transmissão de energia em larga escala."
  },
  {
    id: "finance",
    nome: "All News Finance",
    badge: "Edição Especial • Pré-Market",
    corBadge: "bg-[#EAB308]/15 text-[#FACC15] border-[#EAB308]/30",
    descricao: "Radar diário pré-abertura entregue pontualmente às 06:15 com fechamento de Nova York, Ásia, futuros do Ibovespa e curva de juros.",
    exemplo: "Boletim executivo condensado com os indicadores de liquidez que direcionam as mesas de operação no início do pregão."
  }
];
---

<section class="py-16 sm:py-24" id="cadernos">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#131B26] border border-white/[0.08] text-xs font-semibold text-[#94A3B8] uppercase tracking-wider mb-3">
        Rigor Editorial • Padrão Reuters & The Economist
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-white tracking-tight">
        5 Cadernos Estratégicos Essenciais
      </h2>
      <p class="text-sm sm:text-base text-[#94A3B8] mt-2">
        Eliminação total de ruído e fofocas. Cada nota cumpre a <strong>Fórmula 3-Steps</strong> (O Fato, Mecânica e Desdobramento Crítico) com densidade factual e inteligência acionável.
      </p>
    </div>

    <!-- Grid de Cards dos 5 Cadernos Oficiais + Finance -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {cadernos.map((c) => (
        <div class="group p-6 rounded-xl bg-[#131B26] border border-white/[0.08] hover:border-[#2563EB]/50 hover:bg-[#162030] transition-all duration-200 transform hover:-translate-y-1 flex flex-col justify-between shadow-lg shadow-black/40">
          <div>
            <div class="flex items-center justify-between mb-3.5">
              <span class={`text-[11px] font-semibold px-2.5 py-0.5 rounded-full border ${c.corBadge}`}>
                {c.badge}
              </span>
            </div>
            <h3 class="font-serif text-xl font-bold text-white group-hover:text-[#93C5FD] transition-colors mb-2.5">
              {c.nome}
            </h3>
            <p class="text-xs sm:text-sm text-[#94A3B8] leading-relaxed mb-5">
              {c.descricao}
            </p>
          </div>

          <div class="pt-3.5 border-t border-white/[0.06]">
            <p class="text-[10px] font-semibold uppercase tracking-wider text-[#64748B] mb-1.5">Destaque Analítico Típico</p>
            <p class="text-xs text-[#CBD5E1] italic leading-relaxed">
              "{c.exemplo}"
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
