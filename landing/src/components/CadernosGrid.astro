---
import edicao from "../data/edicao_atual.json";

const cadernosReais = (edicao.cadernos || {}) as Record<string, any[]>;

const cadernosConfig = [
  {
    id: "macroeconomia",
    chaveJson: "Macroeconomia & Mercados",
    nome: "Macroeconomia & Mercados",
    badge: "📊 Economia de Bolso",
    score: "🔥 Score 9.5/10",
    gancho: "Política monetária, juros e câmbio que mexem diretamente no seu poder de compra e carteira.",
    fato: "Decisões de Fed, Copom e BCE, treasury yields e liquidez global explicados sem economês.",
    eDai: "Entenda antes da abertura do pregão onde estão os riscos de inflação, dólar e crédito.",
  },
  {
    id: "geopolitica",
    chaveJson: "Geopolítica & Assuntos Globais",
    nome: "Geopolítica & Assuntos Globais",
    badge: "🌍 Geopolítica & Mundo",
    score: "🔥 Score 9/10",
    gancho: "As alianças, rotas de energia e disputas comerciais que redesenham o tabuleiro global.",
    fato: "Diplomacia de alto nível, cúpulas multilaterais e cadeias de suprimento sob pressão estratégica.",
    eDai: "Antecipe choques de oferta, tarifas e movimentos soberanos antes que virem consenso.",
  },
  {
    id: "estrategia",
    chaveJson: "Estratégia Corporativa & M&A",
    nome: "Estratégia Corporativa & M&A",
    badge: "💼 Negócios & M&A",
    score: "🔥 Score 9/10",
    gancho: "Fusão bilionária, governança executiva e realocação de capital no setor produtivo.",
    fato: "Grandes aquisições, reestruturações patrimoniais e teses de liderança competitiva.",
    eDai: "Identifique quais setores estão consolidando margem e onde surge vantagem competitiva.",
  },
  {
    id: "fronteira-ia",
    chaveJson: "Fronteira Tecnológica & IA",
    nome: "Fronteira Tecnológica & IA",
    badge: "⚡ Tecnologia & IA",
    score: "🔥 Score 9.8/10",
    gancho: "Modelos de fronteira, gargalos de semicondutores e corrida global por infraestrutura de IA.",
    fato: "Capex em data centers, regulação digital e adoção corporativa de agentes autônomos.",
    eDai: "Saiba quais ferramentas, chips e modelos estão redefinindo produtividade e carreira.",
  },
  {
    id: "ciencia",
    chaveJson: "Ciência & Inovação",
    nome: "Ciência & Inovação",
    badge: "🔬 Ciência & Futuro",
    score: "🔥 Score 9/10",
    gancho: "Descobertas com revisão por pares que saem dos laboratórios para transformar indústrias.",
    fato: "Materiais avançados, biotecnologia escalável e transição energética industrial.",
    eDai: "Monitore inovações de longo ciclo antes que se tornem o próximo padrão de mercado.",
  },
  {
    id: "finance",
    chaveJson: "All News Finance",
    nome: "All News Finance",
    badge: "📈 Pré-Market 06:15",
    score: "🔥 Edição Especial",
    gancho: "O pulso das bolsas asiáticas, europeias e futuros americanos antes do café.",
    fato: "Fechamento de Nova York, curva de juros e indicadores de liquidez condensados.",
    eDai: "Comece o dia com clareza absoluta sobre o humor dos mercados em menos de 60 segundos.",
  },
];
---

<section class="py-16 sm:py-24 bg-[#061413] border-t border-[#c9a84c]/20" id="cadernos">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#0b2220] border border-[#c9a84c]/35 text-[11px] font-semibold text-[#d1ba73] uppercase tracking-[0.2em] mb-3">
        Rigor Editorial • Padrão Reuters &amp; The Economist
      </div>
      <h2 class="font-playfair text-3xl sm:text-4xl font-bold text-[#fdfbf7] tracking-tight">
        5 Cadernos Estratégicos Essenciais
      </h2>
      <p class="font-lora text-sm sm:text-base text-[#e5e3de]/80 mt-2.5">
        Eliminação total de ruído. Cada nota segue a anatomia editorial de 4 blocos com densidade factual e inteligência acionável.
      </p>
    </div>

    <!-- Grid de Cards dos Cadernos no Design System Verde/Dourado -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {cadernosConfig.map((c) => {
        const materiasReais = cadernosReais[c.chaveJson];
        const destaqueReal = Array.isArray(materiasReais) && materiasReais.length > 0 ? materiasReais[0] : null;
        const anchorCaderno = `#caderno-${c.chaveJson.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;

        return (
          <div class="editorial-card group relative p-6 rounded-2xl bg-[#0b2220] border border-[#c9a84c]/20 hover:border-[#c9a84c]/55 transition-all duration-300 flex flex-col justify-between shadow-2xl shadow-black/50 overflow-hidden">
            <!-- Lanterna Dourada -->
            <div
              class="card-spotlight pointer-events-none absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
              style="background: radial-gradient(600px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(201, 168, 76, 0.14), transparent 40%);"
            ></div>

            <div class="relative z-10 flex flex-col flex-1">
              <!-- Cabeçalho: Badge Editoria + Score -->
              <div class="flex items-center justify-between gap-2 mb-4">
                <span class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-[#0a5c5a]/45 border border-[#c9a84c]/35 text-[#d1ba73]">
                  {c.badge}
                </span>
                <span class="font-mono-ticker text-[10px] px-2 py-0.5 rounded-full bg-[#061413]/70 border border-[#c9a84c]/25 text-[#c9a84c]">
                  {c.score}
                </span>
              </div>

              <!-- Título do Caderno -->
              <h3 class="font-playfair text-xl font-bold text-[#fdfbf7] group-hover:text-[#d1ba73] transition-colors mb-2">
                {c.nome}
              </h3>

              <!-- 1. O Gancho -->
              <p class="font-lora italic text-xs sm:text-sm text-[#d1ba73]/90 leading-relaxed mb-3">
                {destaqueReal ? destaqueReal.titulo : c.gancho}
              </p>

              <!-- 2. O Fato Limpo -->
              <p class="text-xs text-[#e5e3de]/80 leading-relaxed mb-4">
                {c.fato}
              </p>

              <!-- 3. Caixa "💰 E daí?" -->
              <div class="mt-auto p-3 rounded-r-lg bg-[#0a5c5a]/35 border-l-2 border-[#c9a84c] text-xs leading-relaxed">
                <p class="font-bold text-[#d1ba73] uppercase tracking-wider text-[10px] mb-0.5">
                  💰 E daí?
                </p>
                <p class="text-[#fdfbf7]/90">
                  {c.eDai}
                </p>
              </div>
            </div>

            <!-- 4. Fechamento Interativo -->
            <div class="relative z-10 mt-4 pt-3 border-t border-[#c9a84c]/20 flex items-center justify-between text-[11px]">
              <span class="font-mono-ticker text-[#e5e3de]/65">⏱️ Leitura 45s</span>
              <a
                href={destaqueReal ? anchorCaderno : "#assinar-jornal"}
                class="text-[#d1ba73] hover:text-[#fdfbf7] font-semibold transition-colors"
              >
                {destaqueReal ? "Ver na edição de hoje →" : "Assinar caderno →"}
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
