---
import SubscribeForm from "./SubscribeForm.astro";
---

<section class="relative pt-12 pb-20 sm:pt-20 sm:pb-28 overflow-hidden">
  <!-- Efeitos de iluminação de fundo (Glow sutil) -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-[#2563EB]/15 blur-[120px] rounded-full pointer-events-none -z-10"></div>
  <div class="absolute top-1/3 left-1/3 w-[300px] h-[250px] bg-[#10B981]/10 blur-[100px] rounded-full pointer-events-none -z-10"></div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <!-- Kicker Editorial -->
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#131B26] border border-white/[0.1] text-white/80 text-[11px] font-semibold tracking-wider uppercase mb-6 shadow-inner">
      <span class="w-2 h-2 rounded-full bg-[#EAB308]"></span>
      Informação de Alta Densidade • Sem Ruído
    </div>

    <!-- Manchete Principal Nobre (Serif) -->
    <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold text-white tracking-tight leading-[1.15] mb-6">
      O mundo, tecnologia e economia explicados em <span class="italic text-transparent bg-clip-text bg-gradient-to-r from-white via-[#93C5FD] to-[#3B82F6]">4 minutos matinais.</span>
    </h1>

    <!-- Subtítulo -->
    <p class="max-w-2xl mx-auto text-sm sm:text-lg text-[#94A3B8] font-normal leading-relaxed mb-10">
      Receba diariamente às 06:15 um resumo analítico direto ao ponto, acompanhado do nosso podcast sintético para ouvir durante o café ou no trânsito.
    </p>

    <!-- Formulário de Captura -->
    <div class="mb-8">
      <SubscribeForm />
    </div>

    <!-- Prova de Valor / Selo de Confiança -->
    <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-6 text-xs text-[#64748B]">
      <div class="flex items-center gap-1.5">
        <svg class="text-[#10B981]" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span>100% Gratuito</span>
      </div>
      <span class="text-white/10 hidden sm:inline">•</span>
      <div class="flex items-center gap-1.5">
        <svg class="text-[#10B981]" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span>8 Cadernos Temáticos</span>
      </div>
      <span class="text-white/10 hidden sm:inline">•</span>
      <div class="flex items-center gap-1.5">
        <svg class="text-[#10B981]" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span>Cancele em 1 clique</span>
      </div>
    </div>
  </div>
</section>
