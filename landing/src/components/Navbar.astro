---
const hoje = new Date();
const dataFormatada = hoje.toLocaleDateString("pt-BR", {
  weekday: "long",
  day: "numeric",
  month: "long",
  year: "numeric"
});
const dataCapitalizada = dataFormatada.charAt(0).toUpperCase() + dataFormatada.slice(1);
---

<header class="sticky top-0 z-50 w-full backdrop-blur-md bg-[#0B0F14]/90 border-b border-white/[0.08] transition-all">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Logo Institucional -->
    <a href="/" class="group flex items-center space-x-3">
      <div class="w-8 h-8 rounded-lg bg-[#131B26] border border-white/[0.1] flex items-center justify-center text-white font-serif font-bold text-lg group-hover:border-[#2563EB] transition-colors">
        A
      </div>
      <div>
        <span class="font-serif tracking-widest text-lg sm:text-xl font-bold text-white uppercase block leading-none">
          ALL NEWS JOURNAL
        </span>
        <span class="text-[9px] uppercase tracking-[0.2em] text-[#94A3B8] font-sans font-medium block mt-0.5">
          Digital Executive Edition
        </span>
      </div>
    </a>

    <!-- Data e Badge Live (desktop) -->
    <div class="hidden md:flex items-center space-x-3 text-xs text-[#94A3B8]">
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#10B981]/10 text-[#10B981] border border-[#10B981]/20 font-medium">
        <span class="w-1.5 h-1.5 rounded-full bg-[#10B981] animate-pulse"></span>
        Edição de hoje no ar
      </span>
      <span class="text-white/20">•</span>
      <span>{dataCapitalizada}</span>
    </div>

    <!-- Ações de Navegação -->
    <div class="flex items-center space-x-3 sm:space-x-4">
      <a
        href="#jornal"
        class="hidden sm:inline-flex items-center gap-1.5 text-xs font-medium text-[#94A3B8] hover:text-white transition-colors py-1.5 px-2.5 rounded-lg hover:bg-white/[0.04]"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path>
          <path d="M6 6h10"></path>
          <path d="M6 10h10"></path>
          <path d="M6 14h6"></path>
        </svg>
        Ler Edição de Hoje
      </a>

      <a
        href="#podcast"
        class="hidden sm:inline-flex items-center gap-1.5 text-xs font-medium text-[#94A3B8] hover:text-white transition-colors py-1.5 px-2.5 rounded-lg hover:bg-white/[0.04]"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
          <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
          <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
        </svg>
        Ouvir Áudio
      </a>

      <a
        href="#assinar"
        class="inline-flex items-center gap-2 text-xs font-semibold px-4 py-2 rounded-lg bg-[#2563EB] hover:bg-[#1D4ED8] text-white shadow-lg shadow-[#2563EB]/25 transition-all transform hover:-translate-y-0.5 active:translate-y-0"
      >
        Assinar Grátis
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </div>
</header>
