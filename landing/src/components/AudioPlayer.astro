---
---

<section class="py-12 sm:py-16 border-y border-white/[0.06] bg-[#0E131C]" id="podcast">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="p-6 sm:p-8 rounded-2xl bg-[#131B26] border border-white/[0.08] shadow-2xl relative overflow-hidden">
      <!-- Glow decorativo -->
      <div class="absolute -top-12 -right-12 w-48 h-48 bg-[#2563EB]/20 blur-[80px] rounded-full pointer-events-none"></div>

      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 mb-6">
        <div>
          <div class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[#3B82F6] mb-2">
            <span class="w-2 h-2 rounded-full bg-[#3B82F6] animate-ping"></span>
            Podcast Matinal Diário
          </div>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-white tracking-tight">
            Ouça os destaques do dia com Leo e Ana
          </h2>
          <p class="text-xs sm:text-sm text-[#94A3B8] mt-1.5">
            Vozes neurais inteligentes resumindo fatos cruciais em diálogo dinâmico • Duração: 3 a 5 minutos.
          </p>
        </div>

        <div class="flex items-center gap-3 shrink-0">
          <div class="flex -space-x-2">
            <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-[#1E3A8A] to-[#3B82F6] border-2 border-[#131B26] flex items-center justify-center font-bold text-white text-xs shadow-md" title="Apresentador Leo">
              L
            </div>
            <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-[#065F46] to-[#10B981] border-2 border-[#131B26] flex items-center justify-center font-bold text-white text-xs shadow-md" title="Apresentadora Ana">
              A
            </div>
          </div>
          <div class="text-left">
            <p class="text-xs font-semibold text-white">Apresentação Neural</p>
            <p class="text-[10px] text-[#94A3B8]">NotebookLM Style</p>
          </div>
        </div>
      </div>

      <!-- Player de Áudio Responsivo -->
      <div class="p-4 rounded-xl bg-[#0B0F14] border border-white/[0.08] flex flex-col sm:flex-row items-center gap-4">
        <audio
          controls
          preload="metadata"
          class="w-full accent-[#2563EB] text-white"
        >
          <source src="/audio/latest.mp3" type="audio/mpeg" />
          Seu navegador não suporta o elemento de áudio.
        </audio>
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-between text-xs text-[#64748B]">
        <span>Atualizado automaticamente a cada nova edição matinal</span>
        <span class="inline-flex items-center gap-1 text-[#94A3B8]">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          Também disponível para download direto
        </span>
      </div>
    </div>
  </div>
</section>
