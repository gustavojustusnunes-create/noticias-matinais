---
---

<!-- Mini-Player Flutuante Persistente Estilo Spotify/Apple Podcasts -->
<div
  id="floating-audio-wrapper"
  class="fixed bottom-4 left-1/2 -translate-x-1/2 z-50 max-w-2xl w-[92%] transition-all duration-300"
>
  <!-- Barra Expandida -->
  <div
    id="audio-player-bar"
    class="backdrop-blur-xl bg-[#084c4a]/90 border border-[#c9a84c]/40 rounded-full px-4 sm:px-6 py-2.5 sm:py-3 shadow-2xl shadow-black/75 flex items-center gap-3 sm:gap-4"
  >
    <!-- Botão Play/Pause Dourado + Waveform -->
    <button
      type="button"
      id="audio-play-btn"
      aria-label="Reproduzir ou pausar podcast"
      class="relative w-10 h-10 shrink-0 rounded-full bg-[#c9a84c] hover:bg-[#d1ba73] text-[#061413] flex items-center justify-center shadow-lg shadow-black/40 transition-transform active:scale-95 cursor-pointer"
    >
      <!-- Ícone Play -->
      <svg id="icon-play" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="ml-0.5">
        <polygon points="5 3 19 12 5 21 5 3"></polygon>
      </svg>
      <!-- Ícone Pause -->
      <svg id="icon-pause" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="hidden">
        <rect x="6" y="4" width="4" height="16"></rect>
        <rect x="14" y="4" width="4" height="16"></rect>
      </svg>
    </button>

    <!-- Centro: Título, Waveform CSS e Barra de Progresso Clicável -->
    <div class="flex-1 min-w-0">
      <div class="flex items-center justify-between gap-2 mb-1.5">
        <div class="flex items-center gap-2 min-w-0">
          <!-- Waveform animada (ativa quando tocando) -->
          <div id="audio-waveform" class="flex items-end gap-[2px] h-3 shrink-0 opacity-40 transition-opacity" aria-hidden="true">
            <span class="wave-bar w-[2.5px] bg-[#c9a84c] rounded-full h-1.5"></span>
            <span class="wave-bar w-[2.5px] bg-[#c9a84c] rounded-full h-3"></span>
            <span class="wave-bar w-[2.5px] bg-[#c9a84c] rounded-full h-2"></span>
            <span class="wave-bar w-[2.5px] bg-[#c9a84c] rounded-full h-2.5"></span>
          </div>
          <p class="text-[11px] sm:text-xs font-semibold text-[#fdfbf7] truncate">
            🎧 Edição de Hoje — com Ana &amp; Leo
          </p>
        </div>

        <span id="audio-time-display" class="font-mono-ticker text-[10px] text-[#d1ba73] shrink-0">
          0:00 / 0:00
        </span>
      </div>

      <!-- Seek Bar Clicável -->
      <div
        id="audio-seek-bar"
        role="slider"
        aria-label="Progresso do áudio"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
        tabindex="0"
        class="relative w-full h-1.5 bg-[#061413]/70 rounded-full overflow-hidden cursor-pointer group"
      >
        <div
          id="audio-progress-fill"
          class="h-full bg-gradient-to-r from-[#c9a84c] to-[#d1ba73] rounded-full w-0 transition-[width] duration-100"
        ></div>
      </div>
    </div>

    <!-- Seletor de Velocidade (1x, 1.25x, 1.5x) -->
    <div class="hidden sm:flex items-center gap-1 bg-[#061413]/50 border border-[#c9a84c]/25 rounded-full p-0.5 shrink-0">
      <button
        type="button"
        data-speed="1"
        class="speed-btn px-2 py-0.5 rounded-full text-[10px] font-mono-ticker font-semibold bg-[#c9a84c] text-[#061413] transition-colors cursor-pointer"
      >
        1x
      </button>
      <button
        type="button"
        data-speed="1.25"
        class="speed-btn px-2 py-0.5 rounded-full text-[10px] font-mono-ticker font-semibold text-[#e5e3de]/80 hover:text-[#fdfbf7] transition-colors cursor-pointer"
      >
        1.25x
      </button>
      <button
        type="button"
        data-speed="1.5"
        class="speed-btn px-2 py-0.5 rounded-full text-[10px] font-mono-ticker font-semibold text-[#e5e3de]/80 hover:text-[#fdfbf7] transition-colors cursor-pointer"
      >
        1.5x
      </button>
    </div>

    <!-- Botão de velocidade compacto no mobile -->
    <button
      type="button"
      id="mobile-speed-btn"
      class="sm:hidden px-2 py-1 rounded-full bg-[#061413]/50 border border-[#c9a84c]/25 text-[10px] font-mono-ticker font-semibold text-[#d1ba73] shrink-0 cursor-pointer"
    >
      1x
    </button>

    <!-- Botão Minimizar -->
    <button
      type="button"
      id="audio-minimize-btn"
      aria-label="Minimizar player"
      title="Minimizar player"
      class="w-7 h-7 shrink-0 rounded-full flex items-center justify-center text-[#e5e3de]/70 hover:text-[#fdfbf7] hover:bg-[#061413]/40 transition-colors cursor-pointer"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </button>
  </div>

  <!-- Pílula Minimizada (quando recolhido) -->
  <div id="audio-minimized-pill" class="hidden flex justify-end">
    <button
      type="button"
      id="audio-expand-btn"
      class="inline-flex items-center gap-2 px-4 py-2 rounded-full backdrop-blur-xl bg-[#084c4a]/95 border border-[#c9a84c]/50 text-[#fdfbf7] text-xs font-semibold shadow-2xl shadow-black/75 hover:border-[#d1ba73] transition-all cursor-pointer"
    >
      <span id="mini-wave-dot" class="w-2 h-2 rounded-full bg-[#c9a84c]"></span>
      <span>🎧 Ana &amp; Leo</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#c9a84c]">
        <polyline points="18 15 12 9 6 15"></polyline>
      </svg>
    </button>
  </div>

  <audio id="global-podcast-audio" preload="metadata">
    <source src="/audio/latest.mp3" type="audio/mpeg" />
  </audio>
</div>

<style>
  @keyframes anjWave {
    0%, 100% {
      transform: scaleY(0.4);
    }
    50% {
      transform: scaleY(1);
    }
  }

  #audio-waveform.is-playing .wave-bar {
    animation: anjWave 0.85s ease-in-out infinite;
    transform-origin: bottom;
  }

  #audio-waveform.is-playing .wave-bar:nth-child(2) {
    animation-delay: 0.15s;
  }

  #audio-waveform.is-playing .wave-bar:nth-child(3) {
    animation-delay: 0.3s;
  }

  #audio-waveform.is-playing .wave-bar:nth-child(4) {
    animation-delay: 0.45s;
  }
</style>

<script>
  const audio = document.getElementById("global-podcast-audio") as HTMLAudioElement | null;
  const playBtn = document.getElementById("audio-play-btn");
  const iconPlay = document.getElementById("icon-play");
  const iconPause = document.getElementById("icon-pause");
  const waveform = document.getElementById("audio-waveform");
  const timeDisplay = document.getElementById("audio-time-display");
  const seekBar = document.getElementById("audio-seek-bar");
  const progressFill = document.getElementById("audio-progress-fill");
  const speedBtns = document.querySelectorAll(".speed-btn");
  const mobileSpeedBtn = document.getElementById("mobile-speed-btn");
  const playerBar = document.getElementById("audio-player-bar");
  const minimizedPill = document.getElementById("audio-minimized-pill");
  const minimizeBtn = document.getElementById("audio-minimize-btn");
  const expandBtn = document.getElementById("audio-expand-btn");
  const miniWaveDot = document.getElementById("mini-wave-dot");

  function formatTime(secs: number): string {
    if (!Number.isFinite(secs) || secs < 0) return "0:00";
    const m = Math.floor(secs / 60);
    const s = Math.floor(secs % 60);
    return `${m}:${s.toString().padStart(2, "0")}`;
  }

  function updatePlayUI(isPlaying: boolean) {
    if (isPlaying) {
      iconPlay?.classList.add("hidden");
      iconPause?.classList.remove("hidden");
      waveform?.classList.add("is-playing", "opacity-100");
      waveform?.classList.remove("opacity-40");
      miniWaveDot?.classList.add("animate-ping");
    } else {
      iconPlay?.classList.remove("hidden");
      iconPause?.classList.add("hidden");
      waveform?.classList.remove("is-playing", "opacity-100");
      waveform?.classList.add("opacity-40");
      miniWaveDot?.classList.remove("animate-ping");
    }
  }

  function expandPlayer() {
    playerBar?.classList.remove("hidden");
    minimizedPill?.classList.add("hidden");
  }

  function minimizePlayer() {
    playerBar?.classList.add("hidden");
    minimizedPill?.classList.remove("hidden");
  }

  if (audio) {
    playBtn?.addEventListener("click", () => {
      if (audio.paused) {
        audio.play().catch(() => {});
      } else {
        audio.pause();
      }
    });

    audio.addEventListener("play", () => updatePlayUI(true));
    audio.addEventListener("pause", () => updatePlayUI(false));
    audio.addEventListener("ended", () => updatePlayUI(false));

    const refreshDuration = () => {
      if (timeDisplay) {
        timeDisplay.textContent = `${formatTime(audio.currentTime)} / ${formatTime(audio.duration)}`;
      }
    };

    audio.addEventListener("loadedmetadata", refreshDuration);
    audio.addEventListener("timeupdate", () => {
      refreshDuration();
      if (audio.duration > 0 && progressFill && seekBar) {
        const pct = (audio.currentTime / audio.duration) * 100;
        progressFill.style.width = `${pct}%`;
        seekBar.setAttribute("aria-valuenow", Math.round(pct).toString());
      }
    });

    // Seek Bar clicável
    seekBar?.addEventListener("click", (e: MouseEvent) => {
      if (!audio.duration) return;
      const rect = seekBar.getBoundingClientRect();
      const ratio = Math.min(1, Math.max(0, (e.clientX - rect.left) / rect.width));
      audio.currentTime = ratio * audio.duration;
    });

    // Seletor de velocidade (1x, 1.25x, 1.5x)
    const speeds = [1, 1.25, 1.5];
    let currentSpeedIdx = 0;

    function setPlaybackSpeed(speed: number) {
      if (!audio) return;
      audio.playbackRate = speed;
      currentSpeedIdx = speeds.indexOf(speed);
      if (currentSpeedIdx === -1) currentSpeedIdx = 0;

      speedBtns.forEach((btn) => {
        const btnSpeed = Number((btn as HTMLElement).dataset.speed);
        if (btnSpeed === speed) {
          btn.classList.add("bg-[#c9a84c]", "text-[#061413]");
          btn.classList.remove("text-[#e5e3de]/80");
        } else {
          btn.classList.remove("bg-[#c9a84c]", "text-[#061413]");
          btn.classList.add("text-[#e5e3de]/80");
        }
      });

      if (mobileSpeedBtn) {
        mobileSpeedBtn.textContent = `${speed}x`;
      }
    }

    speedBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const spd = Number((btn as HTMLElement).dataset.speed || "1");
        setPlaybackSpeed(spd);
      });
    });

    mobileSpeedBtn?.addEventListener("click", () => {
      const nextIdx = (currentSpeedIdx + 1) % speeds.length;
      setPlaybackSpeed(speeds[nextIdx]);
    });

    // Minimizar / Expandir
    minimizeBtn?.addEventListener("click", minimizePlayer);
    expandBtn?.addEventListener("click", expandPlayer);

    // Integração imediata com botão "🎧 Ouvir Áudio" da navbar e links #podcast
    const triggerPlay = (e?: Event) => {
      if (e) e.preventDefault();
      expandPlayer();
      audio.play().catch(() => {});
    };

    const navAudioBtn = document.getElementById("nav-btn-audio");
    navAudioBtn?.addEventListener("click", () => {
      expandPlayer();
      audio.play().catch(() => {});
    });

    document.querySelectorAll('a[href="#podcast"]').forEach((link) => {
      link.addEventListener("click", triggerPlay);
    });
  }
</script>
